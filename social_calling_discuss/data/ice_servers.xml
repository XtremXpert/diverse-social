<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- coturn est retiré : les appels passeront par le SFU d'Odoo, qui a sa propre
         IP publique (UDP et TCP), sans relais TURN. On supprime les serveurs ICE
         que ce module créait autrefois (STUN et TURN sur 66.70.177.199:3478).
         Sans serveur ICE configuré, Discuss se rabat sur ses serveurs STUN par défaut. -->
    <delete model="mail.ice.server" search="[('uri', 'in', ['66.70.177.199:3478', 'stun:66.70.177.199:3478', 'turn:66.70.177.199:3478'])]"/>
</odoo>
