<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══ Assets ════════════════════════════════════════════════════════ -->
    <record id="assets_messaging_thread_js" model="ir.asset">
        <field name="name">Social Messaging — OWL component</field>
        <field name="bundle">web.assets_frontend</field>
        <field name="path">/social_messaging/static/src/js/messaging_thread.js</field>
    </record>
    <record id="assets_messaging_thread_xml" model="ir.asset">
        <field name="name">Social Messaging — OWL templates</field>
        <field name="bundle">web.assets_frontend</field>
        <field name="path">/social_messaging/static/src/xml/messaging_thread.xml</field>
    </record>
    <record id="assets_portal_chat_css" model="ir.asset">
        <field name="name">Social Messaging Portal CSS</field>
        <field name="bundle">web.assets_frontend</field>
        <field name="path">/social_messaging/static/src/css/portal_chat.css</field>
    </record>

    <!-- Carte « Messages » du portal home : migrée vers social_messaging_discuss
         (/my/chats). Retirée ici (mise en sourdine). -->

    <!-- ══ Conversations list ════════════════════════════════════════════ -->
    <template id="portal_messages_list" name="My Messages">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="False"/>

            <div class="container py-4" style="max-width:700px;">
                <h1 class="mb-4" style="font-size:1.5rem; color:#1a1a2e;">
                    💬 My Messages
                </h1>

                <t t-if="not thread_data">
                    <div class="card text-center py-5">
                        <div style="font-size:2.5rem;" class="mb-2">💬</div>
                        <p class="text-muted mb-0">No conversations yet.</p>
                        <p class="text-muted" style="font-size:0.85rem;">
                            Visit a member's profile and click "Message" to start one.
                        </p>
                    </div>
                </t>

                <t t-else="">
                    <div class="list-group shadow-sm">
                        <t t-foreach="thread_data" t-as="td">
                            <a t-attf-href="/my/messages/#{td['thread'].id}"
                               t-attf-class="list-group-item list-group-item-action py-3 px-3 #{'' if td['unread'] == 0 else 'bg-light'}">
                                <div class="d-flex align-items-center gap-3">
                                    <!-- Avatar -->
                                    <div style="width:46px; height:46px; border-radius:50%; overflow:hidden; background:#e94560; flex-shrink:0;">
                                        <t t-if="td.get('other_profile') and td['other_profile'].profile_image">
                                            <img t-attf-src="/web/image/club_social_profile.profile/#{td['other_profile'].id}/profile_image"
                                                 class="w-100 h-100" style="object-fit:cover;" alt=""/>
                                        </t>
                                        <t t-else="">
                                            <div class="d-flex align-items-center justify-content-center h-100"
                                                 style="color:white; font-size:18px;">
                                                <t t-out="((td.get('other_profile') and (td['other_profile'].stealth_name or '')) or (td['other'] and td['other'].name) or '?')[0].upper()"/>
                                            </div>
                                        </t>
                                    </div>
                                    <!-- Info -->
                                    <div class="flex-grow-1 overflow-hidden">
                                        <div class="d-flex justify-content-between align-items-baseline">
                                            <span class="fw-semibold" style="font-size:0.95rem;">
                                                <t t-out="(td.get('other_profile') and (td['other_profile'].stealth_name or td['other'].name)) or (td['other'] and td['other'].name) or 'Unknown'"/>
                                            </span>
                                            <span class="text-muted" style="font-size:0.75rem;">
                                                <t t-if="td['thread'].last_message_date">
                                                    <t t-out="td['thread'].last_message_date.strftime('%d/%m %H:%M')"/>
                                                </t>
                                            </span>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="text-muted text-truncate" style="font-size:0.82rem; max-width:260px;">
                                                <t t-out="td['thread'].last_message_preview or '…'"/>
                                            </span>
                                            <t t-if="td['unread']">
                                                <span class="badge rounded-pill" style="background:#e94560; color:white; font-size:0.7rem;">
                                                    <t t-out="td['unread']"/>
                                                </span>
                                            </t>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </t>
                    </div>
                </t>
            </div>
        </t>
    </template>

    <!-- ══ Thread view ═══════════════════════════════════════════════════ -->
    <template id="portal_messages_thread" name="Conversation">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="False"/>

            <div class="container py-4" style="max-width:700px;">

                <!-- Header -->
                <div class="d-flex align-items-center gap-3 mb-3">
                    <a href="/my/messages" class="btn btn-sm btn-outline-secondary">← Back</a>
                    <t t-if="other">
                        <div style="width:40px; height:40px; border-radius:50%; overflow:hidden; background:#e94560; flex-shrink:0;">
                            <t t-if="other_profile and other_profile.profile_image">
                                <img t-attf-src="/web/image/club_social_profile.profile/#{other_profile.id}/profile_image"
                                     class="w-100 h-100" style="object-fit:cover;" alt=""/>
                            </t>
                            <t t-else="">
                                <div class="d-flex align-items-center justify-content-center h-100"
                                     style="color:white; font-size:16px;">
                                    <t t-out="((other_profile and (other_profile.stealth_name or '')) or other.name or '?')[0].upper()"/>
                                </div>
                            </t>
                        </div>
                        <div>
                            <div class="fw-semibold" style="font-size:0.95rem;">
                                <t t-out="(other_profile and (other_profile.stealth_name or other.name)) or other.name"/>
                            </div>
                            <a t-attf-href="/profile/#{other.id}" class="text-muted" style="font-size:0.75rem;">
                                View profile →
                            </a>
                        </div>
                    </t>
                </div>

                <!-- Chat window (public OWL component — mounted by
                     web.public_components via <owl-component>) -->
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <div class="card shadow-sm o-sn-thread-card">
                    <owl-component name="social_messaging.thread"
                                   t-attf-props='{"threadId": #{thread.id}, "currentUserId": #{request.env.user.id}}'/>
                </div>

            </div>
        </t>
    </template>

    <!-- Bouton « Message » du profil : repris par social_messaging_discuss
         (remplacement du lien natif action=mail.action_discuss → /discuss-message).
         Retiré ici : social_messaging est décommissionné, et garder ce replace
         provoquait un conflit de double-replace en install fraîche (deux modules
         remplaçant le même nœud). -->

</odoo>
