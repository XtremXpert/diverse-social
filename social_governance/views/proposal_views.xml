<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── List ── -->
    <record id="view_proposal_list" model="ir.ui.view">
        <field name="name">social_governance.proposal.list</field>
        <field name="model">social_governance.proposal</field>
        <field name="arch" type="xml">
            <list string="Propositions" decoration-info="state == 'open'"
                  decoration-warning="state == 'voting'"
                  decoration-success="state == 'accepted'"
                  decoration-muted="state in ('rejected','inconclusive','withdrawn')">
                <field name="name"/>
                <field name="category_id"/>
                <field name="author_id"/>
                <field name="state"/>
                <field name="voting_closes_at" optional="show"/>
                <field name="vote_count" optional="show"/>
                <field name="approval_pct" optional="show" string="Approbation %"/>
            </list>
        </field>
    </record>

    <!-- ── Form ── -->
    <record id="view_proposal_form" model="ir.ui.view">
        <field name="name">social_governance.proposal.form</field>
        <field name="model">social_governance.proposal</field>
        <field name="arch" type="xml">
            <form string="Proposition">
                <header>
                    <button name="action_open" string="Ouvrir aux commentaires"
                            type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_start_voting" string="Démarrer le vote"
                            type="object" class="oe_highlight"
                            invisible="state not in ('draft','open')"/>
                    <button name="action_close_voting" string="Clore le vote"
                            type="object" class="oe_highlight"
                            invisible="state != 'voting'"/>
                    <button name="action_implement" string="Marquer comme implémentée"
                            type="object"
                            invisible="state != 'accepted'"/>
                    <button name="action_withdraw" string="Retirer"
                            type="object"
                            invisible="state in ('accepted','rejected','inconclusive','withdrawn')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,open,voting,accepted,rejected"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="category_id"/>
                            <field name="author_id"/>
                        </group>
                        <group>
                            <field name="voting_opens_at"/>
                            <field name="voting_closes_at"/>
                            <field name="implemented_at"/>
                        </group>
                    </group>
                    <field name="description"/>

                    <notebook>
                        <page string="Votes" invisible="state not in ('voting','accepted','rejected','inconclusive')">
                            <group>
                                <field name="vote_count" string="Total des votes"/>
                                <field name="yes_count" string="Oui"/>
                                <field name="no_count" string="Non"/>
                                <field name="abstain_count" string="Abstention"/>
                                <field name="approval_pct" string="Approbation %"/>
                                <field name="my_vote" string="Mon vote"/>
                            </group>
                            <group string="Exprimez votre vote" invisible="state != 'voting'">
                                <button name="action_vote" string="Voter Oui"
                                        type="object" class="btn-success"
                                        context="{'default_choice': 'yes'}"
                                        args="['yes']"/>
                                <button name="action_vote" string="Voter Non"
                                        type="object" class="btn-danger"
                                        args="['no']"/>
                                <button name="action_vote" string="S'abstenir"
                                        type="object"
                                        args="['abstain']"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ── Search ── -->
    <record id="view_proposal_search" model="ir.ui.view">
        <field name="name">social_governance.proposal.search</field>
        <field name="model">social_governance.proposal</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="author_id"/>
                <field name="category_id"/>
                <filter name="open" string="Ouverte" domain="[('state','=','open')]"/>
                <filter name="voting" string="Au vote" domain="[('state','=','voting')]"/>
                <filter name="accepted" string="Acceptée" domain="[('state','=','accepted')]"/>
                <filter name="inconclusive" string="Non concluante (quorum)"
                        domain="[('state','=','inconclusive')]"/>
                <separator/>
                <filter name="my_proposals" string="Mes propositions"
                        domain="[('author_id','=',uid)]"/>
                <filter name="by_category" string="Catégorie"
                        context="{'group_by': 'category_id'}"/>
                <filter name="by_state" string="État"
                        context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <!-- ── Action ── -->
    <record id="action_proposals" model="ir.actions.act_window">
        <field name="name">Propositions</field>
        <field name="res_model">social_governance.proposal</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_proposal_search"/>
        <field name="context">{'search_default_open': 1}</field>
    </record>

    <!-- ── Category views ── -->
    <record id="view_category_list" model="ir.ui.view">
        <field name="name">social_governance.proposal_category.list</field>
        <field name="model">social_governance.proposal_category</field>
        <field name="arch" type="xml">
            <list string="Catégories de propositions" editable="top">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="min_quorum" string="Quorum"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="action_categories" model="ir.actions.act_window">
        <field name="name">Catégories de propositions</field>
        <field name="res_model">social_governance.proposal_category</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
