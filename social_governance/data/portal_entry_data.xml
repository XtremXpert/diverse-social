<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Cartes du portail /my (Odoo 20 : portal.entry remplace les t-call portal_docs_entry) -->
    <record id="portal_entry_governance" model="portal.entry">
        <field name="name">Propositions ouvertes au vote</field>
        <field name="url">/governance</field>
        <field name="image" type="bytes" file="social_governance/static/src/img/governance.svg"/>
        <field name="placeholder_count">proposals_voting_count</field>
        <field name="is_config_card" eval="False"/>
        <field name="sequence" eval="35"/>
    </record>
</odoo>
