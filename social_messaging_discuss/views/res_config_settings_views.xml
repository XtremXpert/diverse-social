<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Paramètres généraux › Discuss : contournement de la politique de contact
         pour les utilisateurs internes. -->
    <record id="res_config_settings_view_form_smd" model="ir.ui.view">
        <field name="name">res.config.settings social messaging discuss</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mail.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='discuss']" position="inside">
                <setting id="smd_internal_bypass"
                         help="Les employés peuvent écrire à tout membre du réseau social, même sans connexion ; le blocage reste appliqué.">
                    <field name="smd_internal_bypass"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
