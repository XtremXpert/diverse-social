<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Cartes du portail /my (Odoo 20 : portal.entry remplace les t-call portal_docs_entry) -->
    <record id="portal_entry_my_stories" model="portal.entry">
        <field name="name">Stories</field>
        <field name="url">/my/stories</field>
        <field name="image" type="bytes" file="social_story/static/src/img/stories.svg"/>
        <field name="is_config_card" eval="True"/>
        <field name="sequence" eval="40"/>
    </record>
</odoo>
