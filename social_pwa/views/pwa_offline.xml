<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Offline fallback served by the service worker on network failure. -->
    <template id="offline_page" name="PWA offline shell">
        <t t-call="portal.portal_layout">
            <t t-set="head_title">Offline</t>
            <div class="o_portal_wrap">
                <div class="container py-5">
                    <div class="text-center" style="max-width:480px; margin:0 auto;">
                        <div style="font-size:3rem;">⛅</div>
                        <h3 class="mt-3">You're offline</h3>
                        <p class="text-muted">
                            No connection right now. The app will be ready as soon
                            as you're back online.
                        </p>
                        <button type="button" class="btn btn-primary mt-2"
                                onclick="window.location.reload()">
                            Retry
                        </button>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>
