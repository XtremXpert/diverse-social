<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inject PWA <link> and <meta> tags into every frontend page's <head>.
         Same pattern as social_safety's quick-exit injection. -->
    <template id="pwa_head_tags" inherit_id="web.frontend_layout"
              name="PWA manifest + meta tags">
        <xpath expr="//head" position="inside">
            <t t-set="_pwa_get" t-value="request.env['ir.config_parameter'].sudo().get_str"/>
            <t t-set="_pwa_theme" t-value="_pwa_get('social_pwa.theme_color', '#5fa8d3')"/>
            <t t-set="_pwa_title" t-value="_pwa_get('social_pwa.app_short_name', 'Météo')"/>

            <link rel="manifest" href="/manifest.webmanifest"/>
            <meta name="theme-color" t-att-content="_pwa_theme"/>

            <!-- iOS / Safari standalone-mode hints. PWA install on iOS is
                 driven by these meta tags, not the manifest. -->
            <link rel="apple-touch-icon" href="/social_pwa/static/src/img/apple-touch-icon.png"/>
            <meta name="apple-mobile-web-app-capable" content="yes"/>
            <meta name="apple-mobile-web-app-status-bar-style" content="default"/>
            <meta name="apple-mobile-web-app-title" t-att-content="_pwa_title"/>

            <!-- Generic mobile viewport bump if not already set by the theme. -->
            <meta name="mobile-web-app-capable" content="yes"/>
        </xpath>
    </template>

</odoo>
