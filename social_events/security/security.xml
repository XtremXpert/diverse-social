<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <data noupdate="0">
        <!--
            Club members get event access directly via ir.model.access.csv;
            we do NOT imply event.group_event_registration_desk because it
            transitively implies base.group_user (internal), which would
            conflict with base.group_portal (Role / Portal) on portal members.
        -->
        <!-- Moderators creating events need event.user access -->
        <record id="social_base.group_social_moderator" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('event.group_event_user'))]"/>
        </record>
    </data>
    <data noupdate="1">

        <!--
            Social members see:
            - events without social_visibility set (non-social events)
            - events open to all members
            - circle-gated events where they belong to an allowed circle
        -->
        <!-- Organizer (moderator) can edit their own events -->
        </data>
</odoo>