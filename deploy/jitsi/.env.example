# Jitsi Meet Configuration
# Copy to .env and adjust for your infrastructure

# Domain name (must point to this server)
JITSI_DOMAIN=meet.yourdomain.com

# Timezone
TZ=America/Toronto

# Directories
CONFIG=~/.jitsi-meet-cfg

# Ports
HTTP_PORT=8000
HTTPS_PORT=8443
JVB_COLIBRI_PORT=8080
JVB_TCP_PORT=4443
JVB_TCP_MAPPED_PORT=4443
JVB_UDP_PORT=10000

# Security: Enable authentication (required for privacy compliance)
# Users must log in to create rooms
ENABLE_AUTH=1
AUTH_TYPE=internal
ENABLE_GUESTS=0

# Let's Encrypt (recommended for production)
# ENABLE_LETSENCRYPT=1
# LETSENCRYPT_DOMAIN=meet.yourdomain.com
# LETSENCRYPT_EMAIL=admin@yourdomain.com

# Jicofo credentials (generate strong passwords)
JICOFO_AUTH_PASSWORD=CHANGE_ME_JICOFO_PASS
JICOFO_COMPONENT_SECRET=CHANGE_ME_JICOFO_SECRET

# JVB credentials
JVB_AUTH_PASSWORD=CHANGE_ME_JVB_PASS

# Jibri (recording) - optional
# JIBRI_RECORDER_PASSWORD=CHANGE_ME_JIBRI_RECORDER
# JIBRI_XMPP_PASSWORD=CHANGE_ME_JIBRI_XMPP

# Privacy / Loi 25 hardening
# Disable live streaming (sends data to YouTube/Facebook - third-party sharing)
ENABLE_LIVESTREAMING=0
# Disable recording (Jibri not included in this stack by default)
ENABLE_RECORDING=0

# Public IP (for NAT traversal)
DOCKER_HOST_ADDRESS=YOUR_SERVER_IP

# Video quality limits (optional)
VIDEOBRIDGE_MAX_PARTICIPANTS=20
VIDEOBRIDGE_MAX_CONFERENCES=50
