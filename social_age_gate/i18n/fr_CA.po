#. module: social_age_gate
#: model_terms:ir.ui.view,arch_db:social_age_gate.view_social_onboarding_wizard_age_gate
msgid ""
"<i class=\"fa fa-info-circle me-2\" title=\"Info\"/>\n"
"                        By confirming, you declare on your honor that you are 18 or older."
msgstr "<i class=\"fa fa-info-circle me-2\" title=\"Info\"/>\n                        En confirmant, vous attestez sur l'honneur avoir 18 ans ou plus."

#. module: social_age_gate
#: model_terms:ir.ui.view,arch_db:social_age_gate.view_social_onboarding_wizard_age_gate
msgid ""
"<span invisible=\"step != 'age_gate'\" class=\"badge rounded-pill bg-primary"
" fs-6\">Step 3/5 — Age verification (18+)</span>"
msgstr "<span invisible=\"step != 'age_gate'\" class=\"badge rounded-pill bg-primary fs-6\">Étape 3/5 — Vérification 18+</span>"

#. module: social_age_gate
#: model_terms:ir.ui.view,arch_db:social_age_gate.view_social_onboarding_wizard_age_gate
msgid "Age verification"
msgstr "Vérification de l'âge"

#. module: social_age_gate
#: model:ir.model.fields.selection,name:social_age_gate.selection__social_onboarding_wizard__step__age_gate
msgid "Age verification (18+)"
msgstr "Vérification 18+"

#. module: social_age_gate
#: model:ir.model.fields,field_description:social_age_gate.field_club_social_profile_profile__age_gate_passed
msgid "Age verification (18+) passed"
msgstr "Vérification 18+ validée"

#. module: social_age_gate
#: model_terms:ir.ui.view,arch_db:social_age_gate.portal_age_gate
msgid "Birth year (optional)"
msgstr "Année de naissance (optionnel)"

#. module: social_age_gate
#: model_terms:ir.ui.view,arch_db:social_age_gate.portal_age_gate
msgid "Confirm and continue"
msgstr "Confirmer et accéder"

#. module: social_age_gate
#: model:ir.model.fields,field_description:social_age_gate.field_club_social_profile_profile__display_name
#: model:ir.model.fields,field_description:social_age_gate.field_social_onboarding_wizard__display_name
msgid "Display Name"
msgstr "Nom affiché"

#. module: social_age_gate
#: model:ir.model.fields,field_description:social_age_gate.field_social_onboarding_wizard__age_gate_confirmed
#: model_terms:ir.ui.view,arch_db:social_age_gate.view_social_onboarding_wizard_age_gate
msgid "I confirm I am 18 or older"
msgstr "Je confirme avoir 18 ans ou plus"

#. module: social_age_gate
#: model_terms:ir.ui.view,arch_db:social_age_gate.portal_age_gate
msgid ""
"I declare that I am <strong>18 or older</strong> and accept the terms of use"
" of this adults-only network."
msgstr "Je déclare avoir <strong>18 ans ou plus</strong> et accepte les conditions d'utilisation de ce réseau réservé aux adultes."

#. module: social_age_gate
#: model:ir.model.fields,field_description:social_age_gate.field_club_social_profile_profile__id
#: model:ir.model.fields,field_description:social_age_gate.field_social_onboarding_wizard__id
msgid "ID"
msgstr "ID"

#. module: social_age_gate
#: model:ir.model,name:social_age_gate.model_club_social_profile_profile
msgid "Member Social Profile"
msgstr "Profil social du membre"

#. module: social_age_gate
#. odoo-python
#: code:addons/social_age_gate/controllers/portal.py:0
msgid "Please enter a valid birth year."
msgstr "Veuillez entrer une année de naissance valide."

#. module: social_age_gate
#: model:ir.model.fields,help:social_age_gate.field_club_social_profile_profile__age_gate_passed
msgid ""
"Set to True only when the member explicitly confirms their age via the "
"portal (/age-verify) or the onboarding wizard. Never set automatically from "
"birth_year — that would bypass the explicit consent step."
msgstr "Mis à True uniquement quand le membre confirme explicitement son âge via le portail (/age-verify) ou l'assistant d'intégration. Jamais positionné automatiquement depuis birth_year — cela contournerait l'étape de consentement explicite."

#. module: social_age_gate
#: model:ir.model,name:social_age_gate.model_social_onboarding_wizard
msgid "Social Network Onboarding Wizard"
msgstr "Assistant d'intégration au réseau social"

#. module: social_age_gate
#: model:ir.model.fields,field_description:social_age_gate.field_social_onboarding_wizard__step
msgid "Step"
msgstr "Étape"

#. module: social_age_gate
#: model_terms:ir.ui.view,arch_db:social_age_gate.portal_age_gate
msgid ""
"This private social network is reserved for adults (18 and over).<br/>Please"
" confirm your age to continue."
msgstr "Ce réseau social privé est réservé aux personnes majeures (18 ans et plus).<br/>Veuillez confirmer votre âge pour continuer."

#. module: social_age_gate
#: model_terms:ir.ui.view,arch_db:social_age_gate.view_social_onboarding_wizard_age_gate
msgid "This social network is reserved for adults (18 and over)."
msgstr "Ce réseau social est réservé aux personnes majeures (18 ans et plus)."

#. module: social_age_gate
#. odoo-python
#: code:addons/social_age_gate/controllers/portal.py:0
msgid "You must be 18 or older to access this network."
msgstr "Vous devez avoir 18 ans ou plus pour accéder à ce réseau."

#. module: social_age_gate
#. odoo-python
#: code:addons/social_age_gate/controllers/portal.py:0
msgid "You must check the box to confirm your age."
msgstr "Vous devez cocher la case pour confirmer votre âge."

#. module: social_age_gate
#. odoo-python
#: code:addons/social_age_gate/models/wizard_ext.py:0
msgid "You must confirm being 18 or older to access the social network."
msgstr "Vous devez confirmer avoir 18 ans ou plus pour accéder au réseau social."

#. module: social_age_gate
#: model_terms:ir.ui.view,arch_db:social_age_gate.portal_age_gate
msgid "e.g. 1990"
msgstr "ex. : 1990"

#. module: social_age_gate
#: model_terms:ir.ui.view,arch_db:social_age_gate.portal_age_gate
msgid "🔒 Adults-only access"
msgstr "🔒 Accès réservé aux adultes"
