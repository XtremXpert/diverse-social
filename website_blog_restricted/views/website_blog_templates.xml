<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- Odoo 20 : l'auteur d'un article est rendu par website_blog.post_published_info
     (post_author est vide) ; en édition un div t-field, sinon un div t-out. -->
<template id="post_author_login" inherit_id="website_blog.post_published_info">
    <xpath expr="//div[@t-if='editable'][@t-field='blog_post.author_id']" position="replace">
        <div t-if="editable" t-out="blog_post.author_login"/>
    </xpath>
    <xpath expr="//div[@t-out='blog_post.author_name']" position="replace">
        <div t-else="" class="o_not_editable" t-out="blog_post.author_login"/>
    </xpath>
</template>

<!-- s_dynamic_snippet_template_author : snippet auteur dans les listes dynamiques -->
<template id="s_dynamic_snippet_author_login" inherit_id="website_blog.s_dynamic_snippet_template_author">
    <xpath expr="//span[@t-field='record.author_id.name']" position="replace">
        <span t-out="record.author_login"/>
    </xpath>
</template>

<!-- Badge auteur des listes dynamiques (filtre) -->
<template id="dynamic_filter_blog_post_single_badge_login" inherit_id="website_blog.dynamic_filter_template_blog_post_single_badge">
    <xpath expr="//span[@t-field='record.author_id.name']" position="replace">
        <span class="text-muted" t-out="record.author_login" t-if="blog_posts_post_author_active"/>
    </xpath>
</template>

<!-- blog_feed : flux RSS Atom -->
<template id="blog_feed_login" inherit_id="website_blog.blog_feed">
    <xpath expr="//author/name" position="replace">
        <name t-out="post.author_login"/>
    </xpath>
</template>

</odoo>
