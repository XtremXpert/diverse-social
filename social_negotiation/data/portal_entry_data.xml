<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Cartes du portail /my (Odoo 20 : portal.entry remplace les t-call portal_docs_entry) -->
    <record id="portal_entry_my_negotiation" model="portal.entry">
        <field name="name">Négociations</field>
        <field name="url">/my/negotiation</field>
        <field name="image" type="bytes" file="social_negotiation/static/src/img/negotiation.svg"/>
        <field name="placeholder_count">negotiation_count</field>
        <field name="is_config_card" eval="True"/>
        <field name="sequence" eval="50"/>
    </record>
</odoo>
