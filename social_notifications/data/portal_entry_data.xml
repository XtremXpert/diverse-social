<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Cartes du portail /my (Odoo 20 : portal.entry remplace les t-call portal_docs_entry) -->
    <record id="portal_entry_social_notifications" model="portal.entry">
        <field name="name">Notifications</field>
        <field name="url">/social/notifications</field>
        <field name="image" type="bytes" file="social_notifications/static/src/img/notifications.svg"/>
        <field name="is_config_card" eval="True"/>
        <field name="sequence" eval="50"/>
    </record>
</odoo>
