<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Force OpenStreetMap as the default base_geolocalize provider.
             Without this, _get_provider() falls back to search([], limit=1),
             which is record-order dependent and could pick Google (requires API key). -->
        <record id="set_geocoder_provider_osm" model="ir.config_parameter">
            <field name="key">base_geolocalize.geo_provider</field>
            <field name="value" eval="ref('base_geolocalize.geoprovider_open_street')"/>
        </record>

        <record id="cron_geocode_pending" model="ir.cron">
            <field name="name">Discovery: geocode pending profiles</field>
            <field name="model_id" ref="model_social_discovery_geocoder"/>
            <field name="state">code</field>
            <field name="code">model._geocode_pending_profiles()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
