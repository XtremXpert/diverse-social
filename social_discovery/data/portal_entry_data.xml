<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Cartes du portail /my (Odoo 20 : portal.entry remplace les t-call portal_docs_entry) -->
    <record id="portal_entry_members" model="portal.entry">
        <field name="name">Explorer les membres</field>
        <field name="url">/members</field>
        <field name="image" type="bytes" file="social_discovery/static/src/img/members.svg"/>
        <field name="is_config_card" eval="True"/>
        <field name="sequence" eval="50"/>
    </record>
</odoo>
