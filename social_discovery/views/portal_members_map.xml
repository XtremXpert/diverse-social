<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Map page (full-width) -->
    <template id="members_map_page" name="Members map">
        <t t-call="portal.portal_layout">
            <t t-set="head_title">Carte des membres</t>
            <div class="o_portal_wrap">
                <div class="container-fluid py-4">

                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h2 class="mb-0" style="color:#1a1a2e;">Carte des membres</h2>
                        <div class="d-flex gap-2">
                            <a href="/members" class="btn btn-sm btn-outline-secondary">
                                <i class="oi" data-icon="list"/>
                                <span class="ms-1">Vue liste</span>
                            </a>
                            <a href="/my/profile/edit#privacy" class="btn btn-sm btn-outline-secondary">
                                <i class="oi" data-icon="settings"/>
                                <span class="ms-1">Réglages de la carte</span>
                            </a>
                        </div>
                    </div>

                    <p class="text-muted small mb-3">
                        Les positions sont floutées dans un rayon d'environ 2 à 3 km. Tuiles et géocodage par
                        <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a>.
                        <t t-if="is_moderator">
                            <span class="badge bg-warning text-dark ms-2">Vue modérateur : tous les membres sont visibles</span>
                        </t>
                    </p>

                    <t t-set="_get" t-value="request.env['ir.config_parameter'].sudo().get_str"/>
                    <t t-set="_tile_url"
                       t-value="_get('social_discovery.map_tile_url', 'https://tile.openstreetmap.org/{z}/{x}/{y}.png')"/>
                    <t t-set="_tile_attr"
                       t-value="_get('social_discovery.map_tile_attribution', '&amp;copy; &lt;a href=&quot;https://www.openstreetmap.org/copyright&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;OpenStreetMap&lt;/a&gt;')"/>
                    <t t-set="_tile_max_zoom"
                       t-value="_get('social_discovery.map_tile_max_zoom', '18')"/>
                    <!-- Map centre: configurable per community via leaf module
                         (st_isidore_city_club overrides these XML IDs). Defaults
                         stay at Québec central (46.0/-72.0) for Diverse-style
                         province-wide deployments. -->
                    <t t-set="_map_lat" t-value="_get('social_discovery.map_default_lat', '46.0')"/>
                    <t t-set="_map_lng" t-value="_get('social_discovery.map_default_lng', '-72.0')"/>
                    <t t-set="_map_zoom" t-value="_get('social_discovery.map_default_zoom', '7')"/>

                    <div id="members_map"
                         data-endpoint="/members/map.json"
                         t-att-data-default-lat="_map_lat"
                         t-att-data-default-lng="_map_lng"
                         t-att-data-default-zoom="_map_zoom"
                         t-att-data-tile-url="_tile_url"
                         t-att-data-tile-attribution="_tile_attr"
                         t-att-data-tile-max-zoom="_tile_max_zoom"
                         style="height: 70vh; min-height: 500px;
                                border: 1px solid #ddd; border-radius: 4px;"/>

                    <div id="members_map_status" class="small text-muted mt-2"/>

                </div>
            </div>
        </t>
    </template>

    <!-- Shown when a non-moderator hasn't opted in yet -->
    <template id="members_map_opt_in_required" name="Members map — opt-in required">
        <t t-call="portal.portal_layout">
            <t t-set="head_title">Carte des membres</t>
            <div class="o_portal_wrap">
                <div class="container py-5">
                    <div class="text-center" style="max-width: 540px; margin: 0 auto;">
                        <div style="font-size: 3rem;">🗺️</div>
                        <h3 class="mt-3">M'afficher sur la carte pour voir la carte</h3>
                        <p class="text-muted">
                            La carte des membres est réciproque : pour voir où se
                            trouvent les autres membres, vous devez accepter d'y
                            figurer vous-même. Votre position sera floutée dans un
                            rayon d'environ 2 à 3 km — jamais votre adresse exacte.
                        </p>
                        <a href="/my/profile/edit#privacy" class="btn btn-primary mt-2">
                            Ouvrir mes réglages de confidentialité
                        </a>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>
