<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_social_onboarding_wizard_form" model="ir.ui.view">
        <field name="name">social_onboarding.wizard.form</field>
        <field name="model">social_onboarding.wizard</field>
        <field name="arch" type="xml">
            <form string="Complete my profile" create="false" delete="false">
                <sheet>

                    <!-- Progress indicator -->
                    <div class="text-center mb-4">
                        <span invisible="step != 'welcome'" class="badge rounded-pill bg-primary fs-6">Step 1/4 — Welcome</span>
                        <span invisible="step != 'about'" class="badge rounded-pill bg-primary fs-6">Step 2/4 — About</span>
                        <span invisible="step != 'preferences'" class="badge rounded-pill bg-primary fs-6">Step 3/4 — Preferences</span>
                        <span invisible="step != 'done'" class="badge rounded-pill bg-success fs-6">Profile complete ✓</span>
                    </div>

                    <!-- Step 1: Welcome + photo -->
                    <div invisible="step != 'welcome'">
                        <div class="oe_title text-center mb-4">
                            <h1>Welcome to your social network!</h1>
                            <p class="lead text-muted">
                                Take a few minutes to personalize your profile.
                                You can skip this step and come back later.
                            </p>
                        </div>
                        <group string="Profile picture" col="1">
                            <field name="profile_image" widget="image"
                                   options="{'size': [200, 200], 'preview_image': 'profile_image'}"
                                   nolabel="1"/>
                        </group>
                    </div>

                    <!-- Step 2: About -->
                    <div invisible="step != 'about'">
                        <div class="oe_title mb-3">
                            <h2>About you</h2>
                            <p class="text-muted">This information is shared according to your visibility settings.</p>
                        </div>
                        <group>
                            <group>
                                <field name="pronouns" placeholder="e.g. he/him, she/her, they/them"/>
                                <field name="birth_year" placeholder="e.g. 1990"/>
                                <field name="city" placeholder="e.g. Montréal"/>
                            </group>
                            <group>
                                <field name="bio" placeholder="Tell us about yourself..." widget="text"/>
                            </group>
                        </group>
                    </div>

                    <!-- Step 3: Preferences -->
                    <div invisible="step != 'preferences'">
                        <div class="oe_title mb-3">
                            <h2>Your preferences</h2>
                            <p class="text-muted">You can change these settings at any time from your profile.</p>
                        </div>
                        <group>
                            <group string="Privacy">
                                <field name="visibility" widget="radio"/>
                            </group>
                            <group string="Availability">
                                <field name="availability" widget="radio"/>
                            </group>
                            <group string="Notifications" colspan="2">
                                <field name="digest_email_enabled"/>
                            </group>
                        </group>
                    </div>

                    <!-- Step 4: Done -->
                    <div invisible="step != 'done'" class="text-center py-4">
                        <div class="mb-4">
                            <i class="oi oi-lg text-success" data-icon="check_circle" title="Done"/>
                        </div>
                        <h2 class="text-success">Your profile is complete!</h2>
                        <p class="lead text-muted">
                            You can now explore the social network,
                            post updates, join groups, and connect with other members.
                        </p>
                        <div class="d-flex justify-content-center gap-3 mt-4">
                            <a href="/web#model=social_base.post&amp;view_type=list"
                               class="btn btn-outline-primary">
                                <i class="oi me-1" data-icon="newspaper" title="Feed"/> View feed
                            </a>
                        </div>
                    </div>

                </sheet>

                <footer>
                    <!-- Back -->
                    <button name="action_previous" string="Previous" type="object"
                            class="btn-secondary"
                            invisible="step in ('welcome', 'done')"/>

                    <!-- Next (steps 1-3) -->
                    <button name="action_next" string="Next" type="object"
                            class="btn-primary"
                            invisible="step in ('preferences', 'done')"/>

                    <!-- Finish (step 3) -->
                    <button name="action_finish" string="Finish" type="object"
                            class="btn-primary"
                            invisible="step != 'preferences'"/>

                    <!-- Close (step 4) -->
                    <button name="action_finish" string="Close" type="object"
                            class="btn-primary"
                            invisible="step != 'done'"/>

                    <!-- Skip (steps 1-3) -->
                    <button name="action_skip" string="Later" type="object"
                            class="btn-link text-muted"
                            invisible="step == 'done'"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open the wizard -->
    <record id="action_open_social_onboarding" model="ir.actions.server">
        <field name="name">Complete my profile</field>
        <field name="model_id" ref="model_social_onboarding_wizard"/>
        <field name="state">code</field>
        <field name="code">action = env['social_onboarding.wizard'].action_open()</field>
    </record>

</odoo>
