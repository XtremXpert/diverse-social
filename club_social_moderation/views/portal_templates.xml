<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <template id="portal_report_form" name="Signaler du contenu">
    <t t-call="portal.portal_layout">
      <t t-set="breadcrumbs_searchbar" t-value="False"/>
      <div class="container py-4" style="max-width:560px;">
        <h2 class="mb-1">🚩 Signaler ce contenu</h2>
        <p class="text-muted">Cible : <strong t-out="target_name"/></p>

        <t t-if="error == 'reason_required'">
          <div class="alert alert-danger">Veuillez choisir un motif.</div>
        </t>

        <t t-if="already">
          <div class="alert alert-warning">
            Vous avez déjà signalé ce contenu — un modérateur l'examine.
          </div>
          <a href="/my" class="btn btn-secondary">Retour</a>
        </t>
        <t t-else="">
          <form t-attf-action="/report/#{ref_model}/#{ref_id}/submit"
                method="post" class="card card-body">
            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

            <label class="form-label fw-semibold">Motif <span class="text-danger">*</span></label>
            <select name="reason" class="form-select mb-3" required="required">
              <option value="">— Choisir un motif —</option>
              <t t-foreach="reasons" t-as="r">
                <option t-att-value="r[0]" t-out="r[1]"/>
              </t>
            </select>

            <label class="form-label fw-semibold">Détails (optionnel)</label>
            <textarea name="description" class="form-control mb-3" rows="4"
                      maxlength="1000"
                      placeholder="Précisez le contexte si nécessaire…"/>

            <div class="d-flex justify-content-between align-items-center">
              <a href="javascript:history.back()" class="btn btn-link text-muted">Annuler</a>
              <button type="submit" class="btn btn-danger">Envoyer le signalement</button>
            </div>
          </form>
          <p class="text-muted mt-3" style="font-size:.85rem;">
            Les modérateurs examinent les signalements de manière confidentielle.
            L'auteur du contenu n'est pas informé de votre identité.
          </p>
        </t>
      </div>
    </t>
  </template>

  <template id="portal_report_confirm" name="Signalement reçu">
    <t t-call="portal.portal_layout">
      <t t-set="breadcrumbs_searchbar" t-value="False"/>
      <div class="container py-5 text-center" style="max-width:520px;">
        <div style="font-size:3rem;">✅</div>
        <h2 class="mt-3">Signalement reçu</h2>
        <p class="text-muted">
          Merci. Votre signalement concernant <strong t-out="target_name"/>
          a été transmis aux modérateurs.
        </p>
        <a href="/my" class="btn btn-secondary mt-3">Retour à mon espace</a>
      </div>
    </t>
  </template>

</odoo>
