<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Cartes du portail /my (Odoo 20 : portal.entry remplace les t-call portal_docs_entry) -->
    <record id="portal_entry_my_privacy" model="portal.entry">
        <field name="name">Confidentialité</field>
        <field name="url">/my/privacy</field>
        <field name="image" type="bytes" file="social_privacy/static/src/img/privacy.svg"/>
        <field name="is_config_card" eval="True"/>
        <field name="sequence" eval="35"/>
    </record>
</odoo>
