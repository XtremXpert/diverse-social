<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_retention_rule_list" model="ir.ui.view">
        <field name="name">social_privacy.retention.rule.list</field>
        <field name="model">social_privacy.retention.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="target_model"/>
                <field name="retention_days"/>
                <field name="action"/>
                <field name="active"/>
                <field name="last_run"/>
                <field name="processed_count"/>
            </list>
        </field>
    </record>

    <record id="view_retention_rule_form" model="ir.ui.view">
        <field name="name">social_privacy.retention.rule.form</field>
        <field name="model">social_privacy.retention.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="target_model"/>
                            <field name="date_field"/>
                            <field name="retention_days"/>
                            <field name="action"/>
                        </group>
                    </group>
                    <group string="Filters">
                        <field name="state_filter"/>
                    </group>
                    <group string="Last Run">
                        <field name="last_run" readonly="1"/>
                        <field name="processed_count" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_retention_rule" model="ir.actions.act_window">
        <field name="name">Data Retention Rules</field>
        <field name="res_model">social_privacy.retention.rule</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_retention_rule"
              name="Retention Rules"
              parent="social_privacy.menu_privacy_root"
              action="action_retention_rule"
              sequence="60"/>
</odoo>
