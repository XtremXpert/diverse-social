<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Privacy Policy Page -->
    <template id="portal_privacy_policy" name="Privacy Policy">
        <t t-call="portal.portal_layout">
            <div class="container py-5">
                <div class="row justify-content-center">
                    <div class="col-lg-8">
                        <h1 class="mb-4">Privacy Policy</h1>
                        <t t-if="policy">
                            <div class="alert alert-info">
                                <strong>Version <t t-out="policy.version_number"/></strong>
                                <span class="text-muted ms-2">Effective from <t t-out="policy.effective_date"/></span>
                            </div>
                            <div class="card">
                                <div class="card-body">
                                    <t t-out="policy.content"/>
                                </div>
                            </div>
                        </t>
                        <t t-else="">
                            <div class="alert alert-warning">No active privacy policy is currently published.</div>
                        </t>

                        <!-- User's consent history -->
                        <t t-if="consent_history">
                            <h3 class="mt-5 mb-3">Your Consent History</h3>
                            <div class="list-group">
                                <t t-foreach="consent_history" t-as="consent">
                                    <div class="list-group-item d-flex justify-content-between align-items-center">
                                        <div>
                                            <strong>Version <t t-out="consent.policy_version_number"/></strong>
                                            <div class="text-muted small">
                                                <t t-out="consent.source"/> — <t t-out="consent.consented_at"/>
                                            </div>
                                        </div>
                                        <span t-attf-class="badge {{ 'bg-success' if consent.state == 'accepted' else 'bg-secondary' }}">
                                            <t t-out="consent.state"/>
                                        </span>
                                    </div>
                                </t>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Consent Withdrawal Page -->
    <template id="portal_consent_withdraw" name="Withdraw Consent">
        <t t-call="portal.portal_layout">
            <div class="container py-5">
                <div class="row justify-content-center">
                    <div class="col-lg-6">
                        <h1 class="mb-4">Manage Your Consent</h1>

                        <t t-if="active_consent">
                            <div class="card border-warning">
                                <div class="card-body">
                                    <h5 class="card-title">Active Consent</h5>
                                    <p class="card-text">
                                        You accepted <strong>Privacy Policy v<t t-out="active_consent.policy_version_number"/></strong>
                                        on <t t-out="active_consent.consented_at"/>.
                                    </p>
                                    <form action="/my/privacy/withdraw" method="post" class="mt-3">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <div class="mb-3">
                                            <label class="form-label">Reason for withdrawal (optional)</label>
                                            <textarea name="reason" class="form-control" rows="3" placeholder="Tell us why you are withdrawing your consent..."></textarea>
                                        </div>
                                        <button type="submit" class="btn btn-warning">Withdraw My Consent</button>
                                    </form>
                                </div>
                            </div>
                        </t>
                        <t t-else="">
                            <div class="alert alert-info">
                                You do not currently have an active privacy policy consent on file.
                            </div>
                        </t>

                        <div class="mt-4">
                            <a href="/my/privacy/policy" class="btn btn-outline-primary">Read Privacy Policy</a>
                            <a href="/my/privacy" class="btn btn-outline-secondary ms-2">Back to Privacy Dashboard</a>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Footer DPO Extension -->
    <template id="portal_footer_dpo" name="Footer DPO" inherit_id="portal.frontend_layout">
        <xpath expr="//footer//div[hasclass('container')]" position="inside">
            <div class="row mt-3 pt-3 border-top">
                <div class="col-12 text-center text-muted small">
                    <t t-if="dpo_officer">
                        <span t-esc="dpo_officer.user_id.name"/> — DPO / Privacy Officer
                        <a t-attf-href="mailto:{{ dpo_officer.contact_email }}" class="ms-2 text-muted">
                            <i class="fa fa-envelope-o"/> <t t-out="dpo_officer.contact_email"/>
                        </a>
                        <t t-if="dpo_officer.contact_phone">
                            <span class="ms-2"><i class="fa fa-phone"/> <t t-out="dpo_officer.contact_phone"/></span>
                        </t>
                    </t>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
