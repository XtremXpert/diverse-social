<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_data_export_list" model="ir.ui.view">
        <field name="name">social_privacy.export_request.list</field>
        <field name="model">social_privacy.export_request</field>
        <field name="arch" type="xml">
            <list>
                <field name="user_id" />
                <field name="state" />
                <field name="generated_at" />
                <field name="expires_at" />
            </list>
        </field>
    </record>

    <record id="view_data_export_form" model="ir.ui.view">
        <field name="name">social_privacy.export_request.form</field>
        <field name="model">social_privacy.export_request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate_export" string="Generate Export" type="object" invisible="state != 'pending'" />
                    <button name="action_expire" string="Expire" type="object" invisible="state != 'ready'" />
                    <field name="state" widget="statusbar" statusbar_visible="pending,processing,ready,downloaded,expired" />
                </header>
                <sheet>
                    <group>
                        <field name="user_id" />
                        <field name="state" />
                        <field name="export_filename" />
                        <field name="generated_at" />
                        <field name="expires_at" />
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_ids" widget="mail_thread" />
                </div>
            </form>
        </field>
    </record>

    <record id="action_data_export" model="ir.actions.act_window">
        <field name="name">Data Export Requests</field>
        <field name="res_model">social_privacy.export_request</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_data_export" name="Data Exports" parent="social_privacy.menu_privacy_root" action="action_data_export" sequence="40" />
</odoo>