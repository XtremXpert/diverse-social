<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_privacy_officer_list" model="ir.ui.view">
        <field name="name">social_privacy.officer.list</field>
        <field name="model">social_privacy.officer</field>
        <field name="arch" type="xml">
            <list>
                <field name="user_id" />
                <field name="company_id" />
                <field name="appointment_date" />
                <field name="contact_email" />
                <field name="contact_phone" />
                <field name="is_active" />
            </list>
        </field>
    </record>

    <record id="view_privacy_officer_form" model="ir.ui.view">
        <field name="name">social_privacy.officer.form</field>
        <field name="model">social_privacy.officer</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="user_id" />
                        <field name="company_id" />
                        <field name="appointment_date" />
                        <field name="contact_email" />
                        <field name="contact_phone" />
                        <field name="is_active" />
                        <field name="notes" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_privacy_officer" model="ir.actions.act_window">
        <field name="name">Privacy Officers</field>
        <field name="res_model">social_privacy.officer</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_privacy_root" name="Privacy &amp; Loi 25" parent="base.menu_custom" sequence="100" />

    <menuitem id="menu_privacy_officer" name="Privacy Officers" parent="social_privacy.menu_privacy_root" action="action_privacy_officer" sequence="20" />
</odoo>