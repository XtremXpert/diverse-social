<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_privacy_access_log_list" model="ir.ui.view">
        <field name="name">social_privacy.access_log.list</field>
        <field name="model">social_privacy.access_log</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="create_date" />
                <field name="user_id" />
                <field name="target_user_id" />
                <field name="model_name" />
                <field name="record_id" />
                <field name="action" />
                <field name="reason" />
                <field name="ip_address" />
            </list>
        </field>
    </record>

    <record id="view_privacy_access_log_form" model="ir.ui.view">
        <field name="name">social_privacy.access_log.form</field>
        <field name="model">social_privacy.access_log</field>
        <field name="arch" type="xml">
            <form edit="false" delete="false">
                <sheet>
                    <group>
                        <field name="create_date" />
                        <field name="user_id" />
                        <field name="target_user_id" />
                        <field name="model_name" />
                        <field name="record_id" />
                        <field name="action" />
                        <field name="reason" />
                        <field name="ip_address" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_privacy_access_log" model="ir.actions.act_window">
        <field name="name">Privacy Access Logs</field>
        <field name="res_model">social_privacy.access_log</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_privacy_access_log" name="Access Logs" parent="social_privacy.menu_privacy_root" action="action_privacy_access_log" sequence="50" />
</odoo>