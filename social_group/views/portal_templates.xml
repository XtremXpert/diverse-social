<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <template id="portal_group_list" name="Groups">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Groupes de la communauté</t>
            </t>
            <div class="container mt-3">

                <!-- Alertes -->
                <t t-if="request.params.get('error') == 'name_required'">
                    <div class="alert alert-danger">Le nom du groupe est obligatoire.</div>
                </t>
                <t t-elif="request.params.get('error') == 'create_failed'">
                    <div class="alert alert-danger">Impossible de créer le groupe.</div>
                </t>

                <!-- Create a group -->
                <div class="d-flex justify-content-end mb-3">
                    <button class="btn btn-sm btn-primary" data-bs-toggle="collapse" data-bs-target="#sn_create_group">
                        + Créer un groupe
                    </button>
                </div>
                <div class="collapse mb-4" id="sn_create_group">
                    <div class="card card-body">
                        <form action="/groups/create" method="post">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <div class="mb-2">
                                <input type="text" name="name" class="form-control form-control-sm" placeholder="Nom du groupe" required="required" maxlength="200"/>
                            </div>
                            <div class="mb-2">
                                <textarea name="description" class="form-control form-control-sm" rows="3" placeholder="Description (facultative)" maxlength="2000"/>
                            </div>
                            <div class="row g-2 mb-3">
                                <div class="col-md-6">
                                    <select name="privacy" class="form-select form-select-sm">
                                        <option value="public">Public</option>
                                        <option value="private" selected="selected">Privé</option>
                                        <option value="secret">Secret</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <select name="join_type" class="form-select form-select-sm">
                                        <option value="open">Ouvert</option>
                                        <option value="approval" selected="selected">Sur demande</option>
                                        <option value="invite">Sur invitation seulement</option>
                                    </select>
                                </div>
                            </div>
                            <button type="submit" class="btn btn-sm btn-primary">Créer</button>
                        </form>
                    </div>
                </div>

                <div class="row">
                    <t t-foreach="groups" t-as="group">
                        <div class="col-md-4 mb-4">
                            <div class="card h-100">
                                <div class="card-body">
                                    <h5 class="card-title">
                                        <a t-attf-href="/groups/#{group.id}"><t t-out="group.name"/></a>
                                    </h5>
                                    <p class="text-muted small">
                                        <span t-out="group.member_count"/> membre(s) ·
                                        <t t-if="group.privacy == 'public'">Public</t>
                                        <t t-elif="group.privacy == 'private'">Privé</t>
                                    </p>
                                    <p t-if="group.description" class="card-text small" t-out="group.description"/>
                                    <div class="mt-2">
                                        <t t-if="group.id in my_group_ids">
                                            <span class="badge bg-success">Membre</span>
                                        </t>
                                        <t t-elif="group.join_type == 'open'">
                                            <a t-attf-href="/groups/#{group.id}" class="btn btn-sm btn-outline-primary">Rejoindre</a>
                                        </t>
                                        <t t-elif="group.join_type == 'approval'">
                                            <a t-attf-href="/groups/#{group.id}" class="btn btn-sm btn-outline-secondary">Voir</a>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
                <t t-if="not groups">
                    <p class="text-muted text-center">Aucun groupe disponible.</p>
                </t>
                <div t-if="pager" class="o_portal_pager text-center">
                    <t t-call="portal.pager"/>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_group_detail" name="Group Detail">
        <t t-call="portal.portal_layout">
            <div class="container mt-3">

                <!-- Alertes -->
                <t t-if="request.params.get('created')">
                    <div class="alert alert-success">Groupe créé avec succès.</div>
                </t>
                <t t-if="request.params.get('edited')">
                    <div class="alert alert-success">Groupe mis à jour.</div>
                </t>
                <t t-if="request.params.get('approved')">
                    <div class="alert alert-success">Demande approuvée.</div>
                </t>
                <t t-if="request.params.get('rejected')">
                    <div class="alert alert-info">Demande refusée.</div>
                </t>
                <t t-if="error or request.params.get('error')">
                    <div class="alert alert-danger" t-out="error or request.params.get('error')"/>
                </t>

                <div class="row">
                    <div class="col-lg-8">
                        <h2 t-out="group.name"/>
                        <p class="text-muted">
                            <span t-out="group.member_count"/> membre(s) ·
                            <t t-if="group.privacy == 'public'">Public</t>
                            <t t-elif="group.privacy == 'private'">Privé (adhésion sur demande)</t>
                            <t t-elif="group.privacy == 'secret'">Secret</t>
                        </p>
                        <p t-if="group.description" t-out="group.description"/>

                        <t t-if="not is_member">
                            <t t-if="pending_request">
                                <div class="alert alert-info">Votre demande d'adhésion est en attente.</div>
                            </t>
                            <t t-elif="group.join_type == 'open'">
                                <form t-attf-action="/groups/#{group.id}/join" method="post">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <button type="submit" class="btn btn-primary">Rejoindre</button>
                                </form>
                            </t>
                            <t t-elif="group.join_type == 'approval'">
                                <form t-attf-action="/groups/#{group.id}/join" method="post">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <button type="submit" class="btn btn-outline-primary">Demander à rejoindre</button>
                                </form>
                            </t>
                            <t t-elif="group.join_type == 'invite'">
                                <div class="alert alert-warning">Ce groupe est sur invitation seulement.</div>
                            </t>
                        </t>
                        <t t-else="">
                            <form t-attf-action="/groups/#{group.id}/leave" method="post" class="d-inline">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <button type="submit" class="btn btn-outline-danger btn-sm">Quitter le groupe</button>
                            </form>
                        </t>

                        <!-- Pending requests (group moderators) -->
                        <t t-if="is_mod and pending_requests">
                            <hr/>
                            <h5>Demandes d'adhésion en attente (<t t-out="len(pending_requests)"/>)</h5>
                            <div class="list-group mb-3">
                                <t t-foreach="pending_requests" t-as="req">
                                    <div class="list-group-item d-flex justify-content-between align-items-center py-2">
                                        <span>
                                            <strong t-out="request.env['club_social_profile.profile']._display_name_for_user(req.user_id)"/>
                                            <small class="text-muted ms-2">
                                                <span t-field="req.create_date" t-options="{&quot;widget&quot;:&quot;date&quot;}"/>
                                            </small>
                                        </span>
                                        <div class="d-flex gap-2">
                                            <form t-attf-action="/groups/#{group.id}/requests/#{req.id}/approve" method="post" class="d-inline">
                                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                <button type="submit" class="btn btn-sm btn-success">Accepter</button>
                                            </form>
                                            <form t-attf-action="/groups/#{group.id}/requests/#{req.id}/reject" method="post" class="d-inline">
                                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Refuser</button>
                                            </form>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </t>

                        <!-- Invite a member (group admins) -->
                        <t t-if="is_group_admin">
                            <hr/>
                            <h5>Inviter un membre</h5>
                            <form t-attf-action="/groups/#{group.id}/invite" method="post" class="mb-3">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <div class="mb-2">
                                    <select name="invitee_id" class="form-select form-select-sm" required="required">
                                        <option value="">— Choisir un membre —</option>
                                        <t t-foreach="invitable_users" t-as="u">
                                            <option t-att-value="u.id">
                                                <t t-out="request.env['club_social_profile.profile']._display_name_for_user(u)"/>
                                            </option>
                                        </t>
                                    </select>
                                </div>
                                <div class="mb-2">
                                    <textarea name="message" class="form-control form-control-sm" rows="2" placeholder="Message personnel (facultatif)"/>
                                </div>
                                <button type="submit" class="btn btn-sm btn-primary">Envoyer l'invitation</button>
                            </form>
                        </t>

                        <!-- Pending invitations sent (group admins) -->
                        <t t-if="is_group_admin and pending_invitations">
                            <h6>Invitations envoyées en attente (<t t-out="len(pending_invitations)"/>)</h6>
                            <div class="list-group mb-3">
                                <t t-foreach="pending_invitations" t-as="inv">
                                    <div class="list-group-item d-flex justify-content-between align-items-center py-2">
                                        <span>
                                            <strong t-out="request.env['club_social_profile.profile']._display_name_for_user(inv.invitee_user_id)"/>
                                            <small class="text-muted ms-2">
                                                invité par <t t-out="request.env['club_social_profile.profile']._display_name_for_user(inv.inviter_user_id)"/>,
                                                <span t-field="inv.create_date" t-options="{&quot;widget&quot;:&quot;date&quot;}"/>
                                            </small>
                                        </span>
                                        <form t-attf-action="/groups/#{group.id}/invitations/#{inv.id}/revoke" method="post" class="d-inline">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">Révoquer</button>
                                        </form>
                                    </div>
                                </t>
                            </div>
                        </t>

                        <t t-if="is_member and posts">
                            <hr/>
                            <h5>Publications récentes</h5>
                            <t t-foreach="posts" t-as="post">
                                <div class="border rounded p-3 mb-2">
                                    <strong t-out="request.env['club_social_profile.profile']._display_name_for_user(post.author_id)"/> ·
                                    <small class="text-muted" t-out="post.create_date"/>
                                    <div t-raw="post.content" class="mt-1"/>
                                </div>
                            </t>
                        </t>
                        <t t-elif="is_member">
                            <p class="text-muted mt-3">Aucune publication dans ce groupe pour l'instant.</p>
                        </t>
                    </div>
                    <div class="col-lg-4">
                        <!-- Edit the group (admins) -->
                        <t t-if="is_mod">
                            <div class="card mb-3">
                                <div class="card-header d-flex justify-content-between align-items-center">
                                    <strong>Paramètres du groupe</strong>
                                    <button class="btn btn-sm btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#sn_edit_group">
                                        Modifier
                                    </button>
                                </div>
                                <div class="collapse" id="sn_edit_group">
                                    <div class="card-body">
                                        <form t-attf-action="/groups/#{group.id}/edit" method="post">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <div class="mb-2">
                                                <input type="text" name="name" class="form-control form-control-sm" t-att-value="group.name" required="required" maxlength="200"/>
                                            </div>
                                            <div class="mb-2">
                                                <textarea name="description" class="form-control form-control-sm" rows="3" maxlength="2000"><t t-out="group.description or ''"/></textarea>
                                            </div>
                                            <div class="mb-2">
                                                <select name="privacy" class="form-select form-select-sm">
                                                    <option value="public" t-att-selected="group.privacy == 'public'">Public</option>
                                                    <option value="private" t-att-selected="group.privacy == 'private'">Privé</option>
                                                    <option value="secret" t-att-selected="group.privacy == 'secret'">Secret</option>
                                                </select>
                                            </div>
                                            <div class="mb-3">
                                                <select name="join_type" class="form-select form-select-sm">
                                                    <option value="open" t-att-selected="group.join_type == 'open'">Ouvert</option>
                                                    <option value="approval" t-att-selected="group.join_type == 'approval'">Sur demande</option>
                                                    <option value="invite" t-att-selected="group.join_type == 'invite'">Sur invitation seulement</option>
                                                </select>
                                            </div>
                                            <button type="submit" class="btn btn-sm btn-primary w-100">Enregistrer</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </t>

                        <t t-if="group.rule_ids">
                            <div class="card">
                                <div class="card-header"><strong>Règles du groupe</strong></div>
                                <ul class="list-group list-group-flush">
                                    <t t-foreach="group.rule_ids" t-as="rule">
                                        <li class="list-group-item">
                                            <strong t-out="rule.name"/>
                                            <p t-if="rule.description" class="small text-muted mb-0" t-out="rule.description"/>
                                        </li>
                                    </t>
                                </ul>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_my_groups" name="My Groups">
        <t t-call="portal.portal_layout">
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Mes groupes</t>
            </t>
            <div class="container mt-3">
                <!-- Pending invitations received -->
                <t t-if="pending_invitations">
                    <div class="alert alert-info">
                        <h5>Invitations à des groupes (<t t-out="len(pending_invitations)"/>)</h5>
                        <div class="list-group">
                            <t t-foreach="pending_invitations" t-as="inv">
                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <a t-attf-href="/groups/#{inv.group_id.id}" t-out="inv.group_id.name" class="fw-bold"/>
                                        <small class="text-muted ms-2">
                                            invité par <t t-out="request.env['club_social_profile.profile']._display_name_for_user(inv.inviter_user_id)"/>,
                                            <span t-field="inv.create_date" t-options="{&quot;widget&quot;:&quot;date&quot;}"/>
                                        </small>
                                        <div t-if="inv.message" class="small mt-1">
                                            <em t-out="inv.message"/>
                                        </div>
                                    </div>
                                    <div class="d-flex gap-2">
                                        <form t-attf-action="/groups/invitations/#{inv.id}/accept" method="post" class="d-inline">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <button type="submit" class="btn btn-sm btn-success">Accepter</button>
                                        </form>
                                        <form t-attf-action="/groups/invitations/#{inv.id}/decline" method="post" class="d-inline">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">Refuser</button>
                                        </form>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </t>

                <t t-if="groups">
                    <div class="row">
                        <t t-foreach="groups" t-as="group">
                            <div class="col-md-6 mb-3">
                                <div class="card">
                                    <div class="card-body d-flex justify-content-between align-items-center">
                                        <div>
                                            <h6 class="mb-0">
                                                <a t-attf-href="/groups/#{group.id}" t-out="group.name"/>
                                            </h6>
                                            <small class="text-muted"><span t-out="group.member_count"/> membres</small>
                                        </div>
                                        <form t-attf-action="/groups/#{group.id}/leave" method="post">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Quitter</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </t>
                <t t-else="">
                    <p class="text-muted text-center">Vous n'êtes membre d'aucun groupe. <a href="/groups">Découvrir des groupes</a></p>
                </t>
            </div>
        </t>
    </template>

</odoo>