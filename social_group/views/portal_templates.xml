<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portal_my_home_groups" name="Portal My Home: Groups" inherit_id="portal.portal_my_home" priority="30">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-if="my_groups_count is not None">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="title">My groups</t>
                    <t t-set="url">/my/groups</t>
                    <t t-set="count" t-value="my_groups_count"/>
                </t>
            </t>
        </xpath>
    </template>

    <template id="portal_group_list" name="Groups">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Community groups</t>
            </t>
            <div class="container mt-3">

                <!-- Alertes -->
                <t t-if="request.params.get('error') == 'name_required'">
                    <div class="alert alert-danger">Group name is required.</div>
                </t>
                <t t-elif="request.params.get('error') == 'create_failed'">
                    <div class="alert alert-danger">Unable to create the group.</div>
                </t>

                <!-- Create a group -->
                <div class="d-flex justify-content-end mb-3">
                    <button class="btn btn-sm btn-primary"
                            data-bs-toggle="collapse" data-bs-target="#sn_create_group">
                        + Create a group
                    </button>
                </div>
                <div class="collapse mb-4" id="sn_create_group">
                    <div class="card card-body">
                        <form action="/groups/create" method="post">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <div class="mb-2">
                                <input type="text" name="name" class="form-control form-control-sm"
                                       placeholder="Group name" required="required" maxlength="200"/>
                            </div>
                            <div class="mb-2">
                                <textarea name="description" class="form-control form-control-sm" rows="3"
                                          placeholder="Description (optional)" maxlength="2000"/>
                            </div>
                            <div class="row g-2 mb-3">
                                <div class="col-md-6">
                                    <select name="privacy" class="form-select form-select-sm">
                                        <option value="public">Public</option>
                                        <option value="private" selected="selected">Private</option>
                                        <option value="secret">Secret</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <select name="join_type" class="form-select form-select-sm">
                                        <option value="open">Open</option>
                                        <option value="approval" selected="selected">On request</option>
                                        <option value="invite">Invite only</option>
                                    </select>
                                </div>
                            </div>
                            <button type="submit" class="btn btn-sm btn-primary">Create</button>
                        </form>
                    </div>
                </div>

                <div class="row">
                    <t t-foreach="groups" t-as="group">
                        <div class="col-md-4 mb-4">
                            <div class="card h-100">
                                <div class="card-body">
                                    <h5 class="card-title">
                                        <a t-attf-href="/groups/#{group.id}"><t t-esc="group.name"/></a>
                                    </h5>
                                    <p class="text-muted small">
                                        <span t-esc="group.member_count"/> member(s) ·
                                        <t t-if="group.privacy == 'public'">Public</t>
                                        <t t-elif="group.privacy == 'private'">Private</t>
                                    </p>
                                    <p t-if="group.description" class="card-text small" t-esc="group.description"/>
                                    <div class="mt-2">
                                        <t t-if="group.id in my_group_ids">
                                            <span class="badge bg-success">Member</span>
                                        </t>
                                        <t t-elif="group.join_type == 'open'">
                                            <a t-attf-href="/groups/#{group.id}" class="btn btn-sm btn-outline-primary">Join</a>
                                        </t>
                                        <t t-elif="group.join_type == 'approval'">
                                            <a t-attf-href="/groups/#{group.id}" class="btn btn-sm btn-outline-secondary">View</a>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
                <t t-if="not groups">
                    <p class="text-muted text-center">No groups available.</p>
                </t>
                <div t-if="pager" class="o_portal_pager text-center">
                    <t t-call="portal.pager"/>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_group_detail" name="Group Detail">
        <t t-call="portal.portal_layout">
            <div class="container mt-3">

                <!-- Alertes -->
                <t t-if="request.params.get('created')">
                    <div class="alert alert-success">Group created successfully.</div>
                </t>
                <t t-if="request.params.get('edited')">
                    <div class="alert alert-success">Group updated.</div>
                </t>
                <t t-if="request.params.get('approved')">
                    <div class="alert alert-success">Request approved.</div>
                </t>
                <t t-if="request.params.get('rejected')">
                    <div class="alert alert-info">Request rejected.</div>
                </t>
                <t t-if="error or request.params.get('error')">
                    <div class="alert alert-danger" t-esc="error or request.params.get('error')"/>
                </t>

                <div class="row">
                    <div class="col-lg-8">
                        <h2 t-esc="group.name"/>
                        <p class="text-muted">
                            <span t-esc="group.member_count"/> member(s) ·
                            <t t-if="group.privacy == 'public'">Public</t>
                            <t t-elif="group.privacy == 'private'">Private (request to join)</t>
                            <t t-elif="group.privacy == 'secret'">Secret</t>
                        </p>
                        <p t-if="group.description" t-esc="group.description"/>

                        <t t-if="not is_member">
                            <t t-if="pending_request">
                                <div class="alert alert-info">Your join request is pending.</div>
                            </t>
                            <t t-elif="group.join_type == 'open'">
                                <form t-attf-action="/groups/#{group.id}/join" method="post">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <button type="submit" class="btn btn-primary">Join</button>
                                </form>
                            </t>
                            <t t-elif="group.join_type == 'approval'">
                                <form t-attf-action="/groups/#{group.id}/join" method="post">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <button type="submit" class="btn btn-outline-primary">Request to join</button>
                                </form>
                            </t>
                            <t t-elif="group.join_type == 'invite'">
                                <div class="alert alert-warning">This group is invite-only.</div>
                            </t>
                        </t>
                        <t t-else="">
                            <form t-attf-action="/groups/#{group.id}/leave" method="post" class="d-inline">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <button type="submit" class="btn btn-outline-danger btn-sm">Leave the group</button>
                            </form>
                        </t>

                        <!-- Pending requests (group moderators) -->
                        <t t-if="is_mod and pending_requests">
                            <hr/>
                            <h5>Pending join requests (<t t-esc="len(pending_requests)"/>)</h5>
                            <div class="list-group mb-3">
                                <t t-foreach="pending_requests" t-as="req">
                                    <div class="list-group-item d-flex justify-content-between align-items-center py-2">
                                        <span>
                                            <strong t-esc="req.user_id.name"/>
                                            <small class="text-muted ms-2">
                                                <span t-field="req.create_date" t-options='{"widget":"date"}'/>
                                            </small>
                                        </span>
                                        <div class="d-flex gap-2">
                                            <form t-attf-action="/groups/#{group.id}/requests/#{req.id}/approve"
                                                  method="post" class="d-inline">
                                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                <button type="submit" class="btn btn-sm btn-success">Accept</button>
                                            </form>
                                            <form t-attf-action="/groups/#{group.id}/requests/#{req.id}/reject"
                                                  method="post" class="d-inline">
                                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Reject</button>
                                            </form>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </t>

                        <!-- Invite a member (group admins) -->
                        <t t-if="is_group_admin">
                            <hr/>
                            <h5>Invite a member</h5>
                            <form t-attf-action="/groups/#{group.id}/invite" method="post" class="mb-3">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <div class="mb-2">
                                    <select name="invitee_id" class="form-select form-select-sm" required="required">
                                        <option value="">— Select a member —</option>
                                        <t t-foreach="invitable_users" t-as="u">
                                            <option t-att-value="u.id">
                                                <t t-esc="u.name"/>
                                                <t t-if="u.login != u.name"> (<t t-esc="u.login"/>)</t>
                                            </option>
                                        </t>
                                    </select>
                                </div>
                                <div class="mb-2">
                                    <textarea name="message" class="form-control form-control-sm" rows="2"
                                              placeholder="Optional personal message"/>
                                </div>
                                <button type="submit" class="btn btn-sm btn-primary">Send invitation</button>
                            </form>
                        </t>

                        <!-- Pending invitations sent (group admins) -->
                        <t t-if="is_group_admin and pending_invitations">
                            <h6>Pending invitations sent (<t t-esc="len(pending_invitations)"/>)</h6>
                            <div class="list-group mb-3">
                                <t t-foreach="pending_invitations" t-as="inv">
                                    <div class="list-group-item d-flex justify-content-between align-items-center py-2">
                                        <span>
                                            <strong t-esc="inv.invitee_user_id.name"/>
                                            <small class="text-muted ms-2">
                                                invited by <t t-esc="inv.inviter_user_id.name"/>,
                                                <span t-field="inv.create_date" t-options='{"widget":"date"}'/>
                                            </small>
                                        </span>
                                        <form t-attf-action="/groups/#{group.id}/invitations/#{inv.id}/revoke"
                                              method="post" class="d-inline">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">Revoke</button>
                                        </form>
                                    </div>
                                </t>
                            </div>
                        </t>

                        <t t-if="is_member and posts">
                            <hr/>
                            <h5>Recent posts</h5>
                            <t t-foreach="posts" t-as="post">
                                <div class="border rounded p-3 mb-2">
                                    <strong t-esc="post.author_id.name"/> ·
                                    <small class="text-muted" t-esc="post.create_date"/>
                                    <div t-raw="post.content" class="mt-1"/>
                                </div>
                            </t>
                        </t>
                        <t t-elif="is_member">
                            <p class="text-muted mt-3">No posts in this group yet.</p>
                        </t>
                    </div>
                    <div class="col-lg-4">
                        <!-- Edit the group (admins) -->
                        <t t-if="is_mod">
                            <div class="card mb-3">
                                <div class="card-header d-flex justify-content-between align-items-center">
                                    <strong>Group settings</strong>
                                    <button class="btn btn-sm btn-outline-secondary"
                                            data-bs-toggle="collapse" data-bs-target="#sn_edit_group">
                                        Edit
                                    </button>
                                </div>
                                <div class="collapse" id="sn_edit_group">
                                    <div class="card-body">
                                        <form t-attf-action="/groups/#{group.id}/edit" method="post">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <div class="mb-2">
                                                <input type="text" name="name" class="form-control form-control-sm"
                                                       t-att-value="group.name" required="required" maxlength="200"/>
                                            </div>
                                            <div class="mb-2">
                                                <textarea name="description" class="form-control form-control-sm"
                                                          rows="3" maxlength="2000"><t t-esc="group.description or ''"/></textarea>
                                            </div>
                                            <div class="mb-2">
                                                <select name="privacy" class="form-select form-select-sm">
                                                    <option value="public" t-att-selected="group.privacy == 'public'">Public</option>
                                                    <option value="private" t-att-selected="group.privacy == 'private'">Private</option>
                                                    <option value="secret" t-att-selected="group.privacy == 'secret'">Secret</option>
                                                </select>
                                            </div>
                                            <div class="mb-3">
                                                <select name="join_type" class="form-select form-select-sm">
                                                    <option value="open" t-att-selected="group.join_type == 'open'">Open</option>
                                                    <option value="approval" t-att-selected="group.join_type == 'approval'">On request</option>
                                                    <option value="invite" t-att-selected="group.join_type == 'invite'">Invite only</option>
                                                </select>
                                            </div>
                                            <button type="submit" class="btn btn-sm btn-primary w-100">Save</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </t>

                        <t t-if="group.rule_ids">
                            <div class="card">
                                <div class="card-header"><strong>Group rules</strong></div>
                                <ul class="list-group list-group-flush">
                                    <t t-foreach="group.rule_ids" t-as="rule">
                                        <li class="list-group-item">
                                            <strong t-esc="rule.name"/>
                                            <p t-if="rule.description" class="small text-muted mb-0" t-esc="rule.description"/>
                                        </li>
                                    </t>
                                </ul>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_my_groups" name="My Groups">
        <t t-call="portal.portal_layout">
            <t t-call="portal.portal_searchbar">
                <t t-set="title">My groups</t>
            </t>
            <div class="container mt-3">
                <!-- Pending invitations received -->
                <t t-if="pending_invitations">
                    <div class="alert alert-info">
                        <h5>Group invitations (<t t-esc="len(pending_invitations)"/>)</h5>
                        <div class="list-group">
                            <t t-foreach="pending_invitations" t-as="inv">
                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <a t-attf-href="/groups/#{inv.group_id.id}" t-esc="inv.group_id.name" class="fw-bold"/>
                                        <small class="text-muted ms-2">
                                            invited by <t t-esc="inv.inviter_user_id.name"/>,
                                            <span t-field="inv.create_date" t-options='{"widget":"date"}'/>
                                        </small>
                                        <div t-if="inv.message" class="small mt-1">
                                            <em t-esc="inv.message"/>
                                        </div>
                                    </div>
                                    <div class="d-flex gap-2">
                                        <form t-attf-action="/groups/invitations/#{inv.id}/accept" method="post" class="d-inline">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <button type="submit" class="btn btn-sm btn-success">Accept</button>
                                        </form>
                                        <form t-attf-action="/groups/invitations/#{inv.id}/decline" method="post" class="d-inline">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">Decline</button>
                                        </form>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </t>

                <t t-if="groups">
                    <div class="row">
                        <t t-foreach="groups" t-as="group">
                            <div class="col-md-6 mb-3">
                                <div class="card">
                                    <div class="card-body d-flex justify-content-between align-items-center">
                                        <div>
                                            <h6 class="mb-0">
                                                <a t-attf-href="/groups/#{group.id}" t-esc="group.name"/>
                                            </h6>
                                            <small class="text-muted"><span t-esc="group.member_count"/> members</small>
                                        </div>
                                        <form t-attf-action="/groups/#{group.id}/leave" method="post">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Leave</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </t>
                <t t-else="">
                    <p class="text-muted text-center">You are not a member of any group. <a href="/groups">Discover groups</a></p>
                </t>
            </div>
        </t>
    </template>

</odoo>
