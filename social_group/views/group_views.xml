<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_social_group_list" model="ir.ui.view">
            <field name="name">social_group.group.list</field>
            <field name="model">social_group.group</field>
            <field name="arch" type="xml">
                <list string="Groups" default_order="name">
                    <field name="name"/>
                    <field name="privacy"/>
                    <field name="join_type"/>
                    <field name="member_count"/>
                    <field name="post_count"/>
                    <field name="creator_id"/>
                    <field name="create_date"/>
                </list>
            </field>
        </record>

        <record id="view_social_group_form" model="ir.ui.view">
            <field name="name">social_group.group.form</field>
            <field name="model">social_group.group</field>
            <field name="arch" type="xml">
                <form string="Group">
                    <header>
                        <button name="action_join" string="Join" type="object" class="btn-primary"/>
                        <button name="action_leave" string="Leave" type="object"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="privacy"/>
                                <field name="join_type"/>
                                <field name="require_moderation"/>
                            </group>
                            <group>
                                <field name="creator_id" readonly="1"/>
                                <field name="member_count" readonly="1"/>
                                <field name="post_count" readonly="1"/>
                            </group>
                        </group>
                        <field name="description" nolabel="1" placeholder="Group description..."/>
                        <notebook>
                            <page string="Members">
                                <field name="member_ids">
                                    <list>
                                        <field name="name"/>
                                        <field name="login"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Administrators">
                                <field name="admin_ids">
                                    <list><field name="name"/></list>
                                </field>
                            </page>
                            <page string="Rules">
                                <field name="rule_ids">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                        <field name="description"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Join Requests">
                                <field name="join_request_ids">
                                    <list>
                                        <field name="user_id"/>
                                        <field name="create_date"/>
                                        <field name="state"/>
                                        <button name="action_approve" string="Approve" type="object"
                                                invisible="state != 'pending'"
                                                groups="social_base.group_social_moderator"/>
                                        <button name="action_reject" string="Reject" type="object"
                                                invisible="state != 'pending'"
                                                groups="social_base.group_social_moderator"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_social_groups" model="ir.actions.act_window">
            <field name="name">Groups</field>
            <field name="res_model">social_group.group</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_social_groups" name="Groups"
                  parent="social_base.menu_social_base_root"
                  sequence="30"
                  action="action_social_groups"/>

    </data>
</odoo>
