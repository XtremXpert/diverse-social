<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="board" name="Disponible maintenant">
        <t t-call="portal.portal_layout">
            <t t-set="head_title">Disponible maintenant</t>
            <div class="o_portal_wrap">
                <div class="container py-4" style="max-width:900px;" id="right_now_board">

                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                        <h2 class="mb-0" style="color:#1a1a2e;">⚡ Disponible maintenant</h2>
                        <span class="badge bg-secondary" t-out="len(cards)"/>
                    </div>
                    <p class="text-muted">
                        Les membres disponibles peuvent être contactés par tout le monde,
                        même hors de tes connexions, groupes et cercles. Les conversations
                        se referment à la fin de la session — sauf si vous vous connectez.
                    </p>

                    <!-- Activation / état de MA session -->
                    <div class="card mb-4">
                        <div class="card-body">
                            <t t-if="my_session">
                                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                    <div>
                                        <span class="fw-semibold text-success">● Tu es disponible</span>
                                        <span class="text-muted small d-block">
                                            Jusqu'à
                                            <t t-out="my_session.expires_at" t-options='{"widget": "datetime"}'/>
                                        </span>
                                    </div>
                                    <form action="/right-now/deactivate" method="post" class="m-0">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <button type="submit" class="btn btn-outline-secondary btn-sm">
                                            Terminer maintenant
                                        </button>
                                    </form>
                                </div>
                            </t>
                            <t t-else="">
                                <form action="/right-now/activate" method="post">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <div class="row g-2 align-items-end">
                                        <div class="col-sm-3">
                                            <label class="form-label small fw-semibold mb-1">Durée</label>
                                            <select name="duration" class="form-select">
                                                <option value="1h">1 heure</option>
                                                <option value="2h">2 heures</option>
                                                <option value="4h">4 heures</option>
                                            </select>
                                        </div>
                                        <div class="col-sm-6">
                                            <label class="form-label small fw-semibold mb-1">
                                                Intention (optionnel)
                                            </label>
                                            <input type="text" name="note" class="form-control"
                                                   maxlength="120"
                                                   placeholder="Ce que tu cherches là, maintenant…"/>
                                        </div>
                                        <div class="col-sm-3">
                                            <button type="submit" class="btn w-100"
                                                    style="background:#e94560;color:white;">
                                                Me rendre disponible
                                            </button>
                                        </div>
                                    </div>
                                </form>
                            </t>
                        </div>
                    </div>

                    <!-- Grille des membres disponibles -->
                    <t t-if="cards">
                        <div class="row g-3">
                            <t t-foreach="cards" t-as="card">
                                <div class="col-md-6">
                                    <div class="card h-100">
                                        <div class="card-body d-flex gap-3">
                                            <img t-attf-src="/web/image/club_social_profile.profile/#{card['profile'].id}/profile_image"
                                                 class="rounded-circle flex-shrink-0"
                                                 style="width:56px;height:56px;object-fit:cover;"
                                                 alt="avatar"/>
                                            <div class="flex-grow-1">
                                                <div class="d-flex justify-content-between align-items-start">
                                                    <a t-attf-href="/profile/#{card['user'].id}"
                                                       class="fw-semibold text-decoration-none"
                                                       style="color:#1a1a2e;"
                                                       t-out="card['display_name']"/>
                                                    <span class="badge bg-success-subtle text-success"
                                                          t-att-data-minutes-left="card['minutes_left']">
                                                        <t t-out="card['minutes_left']"/> min
                                                    </span>
                                                </div>
                                                <div t-if="card['note']" class="small text-muted mt-1"
                                                     t-out="card['note']"/>
                                                <a t-attf-href="/right-now/message/#{card['user'].id}"
                                                   class="btn btn-sm btn-outline-secondary mt-2">
                                                    💬 Écrire
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="text-center text-muted py-5">
                            <div style="font-size:2rem;">🌙</div>
                            <p class="mb-0">Personne n'est disponible pour l'instant.
                                Rends-toi disponible pour ouvrir le bal.</p>
                        </div>
                    </t>

                </div>
            </div>
        </t>
    </template>

</odoo>
