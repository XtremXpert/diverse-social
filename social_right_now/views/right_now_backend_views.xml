<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_right_now_session_list" model="ir.ui.view">
        <field name="name">social_right_now.session.list</field>
        <field name="model">social_right_now.session</field>
        <field name="arch" type="xml">
            <list string="Sessions « Disponible maintenant »">
                <field name="user_id"/>
                <field name="note"/>
                <field name="started_at"/>
                <field name="expires_at"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_right_now_session_form" model="ir.ui.view">
        <field name="name">social_right_now.session.form</field>
        <field name="model">social_right_now.session</field>
        <field name="arch" type="xml">
            <form string="Session">
                <sheet>
                    <group>
                        <field name="user_id"/>
                        <field name="duration"/>
                        <field name="started_at"/>
                        <field name="expires_at"/>
                        <field name="state"/>
                    </group>
                    <field name="note" placeholder="Intention affichée sur le tableau (modérable)"/>
                    <field name="channel_ids" widget="many2many_tags"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_right_now_session" model="ir.actions.act_window">
        <field name="name">Disponible maintenant</field>
        <field name="res_model">social_right_now.session</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_right_now_root" name="Disponible maintenant"
              parent="social_base.menu_social_base_root"
              action="action_right_now_session"
              groups="social_base.group_social_moderator"
              sequence="80"/>

</odoo>
