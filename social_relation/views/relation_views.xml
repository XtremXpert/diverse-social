<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="social_relation_view_form" model="ir.ui.view">
        <field name="name">social_relation.relation.form</field>
        <field name="model">social_relation.relation</field>
        <field name="arch" type="xml">
            <form string="Relation">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_128'}"/>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <field name="relation_type_id"/>
                        <field name="is_visible"/>
                        <field name="channel_id"/>
                    </group>
                    <field name="description" placeholder="Description"/>
                    <field name="member_ids">
                        <list editable="bottom">
                            <field name="user_id"/>
                            <field name="state"/>
                            <field name="share_publicly"/>
                            <field name="invited_by_id"/>
                            <field name="joined_at"/>
                        </list>
                    </field>
                    <field name="pair_relation_ids" readonly="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="social_relation_view_list" model="ir.ui.view">
        <field name="name">social_relation.relation.list</field>
        <field name="model">social_relation.relation</field>
        <field name="arch" type="xml">
            <list string="Relations">
                <field name="name"/>
                <field name="member_count"/>
                <field name="state" widget="badge" decoration-success="state == 'active'" decoration-muted="state == 'dissolved'"/>
                <field name="is_visible"/>
            </list>
        </field>
    </record>

    <record id="social_relation_action" model="ir.actions.act_window">
        <field name="name">Relations</field>
        <field name="res_model">social_relation.relation</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_social_relations" name="Relations"
              parent="social_reputation.menu_reputation_root" sequence="50"
              action="social_relation_action"
              groups="social_base.group_social_moderator"/>
</odoo>
