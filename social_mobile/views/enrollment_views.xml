<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="social_mobile_enrollment_view_list" model="ir.ui.view">
        <field name="name">social_mobile.enrollment.list</field>
        <field name="model">social_mobile.enrollment</field>
        <field name="arch" type="xml">
            <list string="Inscriptions mobiles" create="0" edit="0">
                <field name="create_date" string="Créée le"/>
                <field name="email"/>
                <field name="device_name"/>
                <field name="state" widget="badge" decoration-info="state == 'pending'" decoration-success="state == 'sponsored'"/>
                <field name="sponsor_id"/>
                <field name="expires_at"/>
            </list>
        </field>
    </record>

    <record id="social_mobile_enrollment_action" model="ir.actions.act_window">
        <field name="name">Inscriptions mobiles</field>
        <field name="res_model">social_mobile.enrollment</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucune inscription en attente</p>
            <p>Une inscription apparaît ici quand un nouveau venu saisit son courriel dans l'application,
               et disparaît dès qu'un membre l'a parrainé (ou après 24 heures).</p>
        </field>
    </record>

    <menuitem id="menu_social_mobile_root" name="Application mobile" sequence="96"
              web_icon="social_mobile,static/description/icon.png"
              groups="social_base.group_social_admin"/>
    <menuitem id="menu_social_mobile_enrollments" name="Inscriptions en attente"
              parent="menu_social_mobile_root" sequence="10"
              action="social_mobile_enrollment_action"/>
</odoo>
