<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!--
        Default circle types — admin-managed, members choose from this list.
        noupdate="1": admin changes are preserved on module upgrade.
    -->

    <record id="circle_type_connaissances" model="social_circles.circle_type">
        <field name="name">Acquaintances</field>
        <field name="description">People you know — default circle for new connections.</field>
        <field name="sequence">100</field>
        <field name="color">0</field>
        <field name="is_default" eval="True"/>
    </record>

    <record id="circle_type_amis" model="social_circles.circle_type">
        <field name="name">Close friends</field>
        <field name="description">People you have particular trust in.</field>
        <field name="sequence">20</field>
        <field name="color">10</field>
    </record>

    <record id="circle_type_partenaires" model="social_circles.circle_type">
        <field name="name">Partners</field>
        <field name="description">Intimate or romantic partners.</field>
        <field name="sequence">10</field>
        <field name="color">1</field>
    </record>

    <record id="circle_type_vip" model="social_circles.circle_type">
        <field name="name">VIP</field>
        <field name="description">Privileged access — people you grant maximum visibility.</field>
        <field name="sequence">5</field>
        <field name="color">3</field>
    </record>

    <record id="circle_type_famille" model="social_circles.circle_type">
        <field name="name">Chosen family</field>
        <field name="description">Family in the broad sense — strong non-romantic ties.</field>
        <field name="sequence">30</field>
        <field name="color">6</field>
    </record>

</odoo>
