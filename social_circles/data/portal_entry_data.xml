<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Cartes du portail /my (Odoo 20 : portal.entry remplace les t-call portal_docs_entry) -->
    <record id="portal_entry_my_circles" model="portal.entry">
        <field name="name">Cercles</field>
        <field name="url">/my/circles</field>
        <field name="image" type="bytes" file="social_circles/static/src/img/circles.svg"/>
        <field name="is_config_card" eval="True"/>
        <field name="sequence" eval="45"/>
    </record>
</odoo>
