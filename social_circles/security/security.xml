<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Circle owner: full access to own circles -->
        <record id="rule_circle_owner" model="ir.rule">
            <field name="name">Social Circle: owner access</field>
            <field name="model_id" ref="model_social_circles_circle"/>
            <field name="domain_force">[('profile_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('social_base.group_social_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Circle invitation: inviter (owner) or invitee sees it -->
        <record id="rule_circle_invitation_own" model="ir.rule">
            <field name="name">Circle Invitation: own</field>
            <field name="model_id" ref="model_social_circles_invitation"/>
            <field name="domain_force">['|', ('inviter_user_id', '=', user.id), ('invitee_user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('social_base.group_social_user'))]"/>
        </record>

        <!-- Any member can read circles they belong to (to know their access level) -->
        <record id="rule_circle_member_read" model="ir.rule">
            <field name="name">Social Circle: member read</field>
            <field name="model_id" ref="model_social_circles_circle"/>
            <field name="domain_force">[('member_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('social_base.group_social_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Social users can read all platform user profiles (needed for circle member display) -->
        <record id="rule_res_users_social_read" model="ir.rule">
            <field name="name">Social User: read all platform users</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('social_base.group_social_user')), (4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>
