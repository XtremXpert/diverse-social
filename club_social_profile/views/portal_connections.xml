<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portal_my_connections" name="My connections">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="False"/>
            <t t-set="page_name" t-value="'my_connections'"/>

            <div class="container py-4">
                <h1 class="mb-4" style="font-size:1.6rem; color:#1a1a2e;">
                    🤝 My connections
                </h1>

                <!-- Pending received -->
                <t t-if="pending_received">
                    <div class="card mb-4">
                        <div class="card-header fw-bold" style="background:#1a1a2e; color:white;">
                            📥 Pending requests received (<t t-out="len(pending_received)"/>)
                        </div>
                        <div class="list-group list-group-flush">
                            <t t-foreach="pending_received" t-as="conn">
                                <a t-attf-href="/profile/#{conn.user_id.id}"
                                   class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                    <span t-out="conn.user_id.name"/>
                                    <span class="badge bg-warning text-dark">Pending</span>
                                </a>
                            </t>
                        </div>
                    </div>
                </t>

                <!-- Accepted -->
                <div class="card mb-4">
                    <div class="card-header fw-bold" style="background:#1a1a2e; color:white;">
                        ✅ Connections (<t t-out="len(accepted)"/>)
                    </div>
                    <t t-if="accepted">
                        <div class="list-group list-group-flush">
                            <t t-foreach="accepted" t-as="conn">
                                <a t-attf-href="/profile/#{conn.connected_user_id.id}"
                                   class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                    <span t-out="conn.connected_user_id.name"/>
                                    <small class="text-muted" t-out="conn.create_date and conn.create_date.strftime('%Y-%m-%d') or ''"/>
                                </a>
                            </t>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="card-body text-muted">
                            You have no connections yet.
                            <a href="/discover">Discover members</a>
                            to send your first request.
                        </div>
                    </t>
                </div>

                <!-- Pending sent -->
                <t t-if="pending_sent">
                    <div class="card mb-4">
                        <div class="card-header fw-bold" style="background:#1a1a2e; color:white;">
                            📤 Pending requests sent (<t t-out="len(pending_sent)"/>)
                        </div>
                        <div class="list-group list-group-flush">
                            <t t-foreach="pending_sent" t-as="conn">
                                <a t-attf-href="/profile/#{conn.connected_user_id.id}"
                                   class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                    <span t-out="conn.connected_user_id.name"/>
                                    <span class="badge bg-secondary">Waiting</span>
                                </a>
                            </t>
                        </div>
                    </div>
                </t>

            </div>
        </t>
    </template>

</odoo>
