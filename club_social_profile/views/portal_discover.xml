<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <!-- ══ Portal home entry ═════════════════════════════════════════════ -->
    <!-- ══ Discover page ═════════════════════════════════════════════════ -->
    <template id="portal_discover" name="Discover members">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="False"/>

            <div class="container py-4" style="max-width:1100px;">
                <h1 class="mb-4" style="font-size:1.5rem; color:#1a1a2e;">🔍 Discover members</h1>

                <!-- ── Filters ───────────────────────────────────────── -->
                <form method="get" action="/discover" class="card card-body mb-4 p-3">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-2">
                            <label class="form-label form-label-sm text-muted mb-1">City</label>
                            <input type="text" name="city" class="form-control form-control-sm" placeholder="Montréal…" t-att-value="city"/>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label form-label-sm text-muted mb-1">Gender</label>
                            <select name="gender" class="form-select form-select-sm">
                                <option value="">— All —</option>
                                <t t-foreach="gender_labels.items()" t-as="item">
                                    <option t-att-value="item[0]" t-att-selected="item[0] == gender and 'selected' or None" t-out="item[1]"/>
                                </t>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label form-label-sm text-muted mb-1">Orientation</label>
                            <select name="orientation" class="form-select form-select-sm">
                                <option value="">— All —</option>
                                <t t-foreach="orientation_labels.items()" t-as="item">
                                    <option t-att-value="item[0]" t-att-selected="item[0] == orientation and 'selected' or None" t-out="item[1]"/>
                                </t>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label form-label-sm text-muted mb-1">Availability</label>
                            <select name="availability" class="form-select form-select-sm">
                                <option value="">— All —</option>
                                <t t-foreach="availability_labels.items()" t-as="item">
                                    <option t-att-value="item[0]" t-att-selected="item[0] == availability and 'selected' or None" t-out="item[1]"/>
                                </t>
                            </select>
                        </div>
                        <t t-if="has_bdsm">
                            <div class="col-md-2">
                                <label class="form-label form-label-sm text-muted mb-1">BDSM role</label>
                                <select name="bdsm_role" class="form-select form-select-sm">
                                    <option value="">— All —</option>
                                    <t t-foreach="bdsm_role_labels.items()" t-as="item">
                                        <option t-att-value="item[0]" t-att-selected="item[0] == bdsm_role and 'selected' or None" t-out="item[1]"/>
                                    </t>
                                </select>
                            </div>
                        </t>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-sm w-100" style="background:#e94560;color:white;">
                                Filter
                            </button>
                        </div>
                        <t t-if="city or gender or orientation or availability or bdsm_role">
                            <div class="col-12">
                                <a href="/discover" class="btn btn-sm btn-outline-secondary">
                                    ✕ Clear filters
                                </a>
                            </div>
                        </t>
                    </div>
                </form>

                <!-- ── Count ─────────────────────────────────────────── -->
                <p class="text-muted mb-3" style="font-size:.85rem;">
                    <t t-out="total"/> membre<t t-if="total &gt; 1">s</t> trouvé<t t-if="total &gt; 1">s</t>
                </p>

                <!-- ── Profile grid ───────────────────────────────────── -->
                <div class="row g-3 mb-4">
                    <t t-foreach="profiles" t-as="profile">
                        <div class="col-sm-6 col-md-4 col-lg-3">
                            <a t-attf-href="/profile/#{profile.user_id.id}" class="card h-100 text-decoration-none" style="border-top:3px solid #1a1a2e; transition:.15s;">
                                <!-- Avatar -->
                                <div class="text-center pt-3 pb-1">
                                    <t t-if="profile.profile_image">
                                        <img t-att-src="'/web/image/club_social_profile.profile/' + str(profile.id) + '/profile_image/80x80'" class="rounded-circle" style="width:72px;height:72px;object-fit:cover;border:2px solid #e94560;"/>
                                    </t>
                                    <t t-else="">
                                        <div style="width:72px;height:72px;border-radius:50%;background:#1a1a2e;display:inline-flex;align-items:center;justify-content:center;color:white;font-size:28px;border:2px solid #e94560;">
                                            <t t-out="((profile.stealth_name or profile.user_id.name or '?')[0]).upper()"/>
                                        </div>
                                    </t>
                                </div>

                                <div class="card-body pt-1 pb-2 text-center">
                                    <!-- Name -->
                                    <div class="fw-semibold text-truncate" style="color:#1a1a2e; font-size:.95rem;">
                                        <t t-out="profile.stealth_name or profile.user_id.name"/>
                                    </div>

                                    <!-- City -->
                                    <t t-if="profile.city">
                                        <div class="text-muted" style="font-size:.78rem;">
                                            📍 <t t-out="profile.city"/>
                                        </div>
                                    </t>

                                    <!-- Availability -->
                                    <t t-if="profile.availability and profile.availability != 'non_specifie'">
                                        <div class="mt-1">
                                            <span t-attf-class="badge #{profile.availability == 'disponible' and 'bg-success' or profile.availability == 'couple_ouvert' and 'bg-info text-dark' or 'bg-secondary'}" style="font-size:.7rem;">
                                                <t t-out="availability_labels.get(profile.availability, '')"/>
                                            </span>
                                        </div>
                                    </t>

                                    <!-- BDSM role -->
                                    <t t-if="has_bdsm and profile.bdsm_role">
                                        <div class="mt-1">
                                            <span class="badge" style="background:#e94560;color:white;font-size:.7rem;">
                                                <t t-out="bdsm_role_labels.get(profile.bdsm_role, profile.bdsm_role)"/>
                                            </span>
                                        </div>
                                    </t>

                                    <!-- Connexion badge -->
                                    <t t-if="profile.user_id.id in connected_user_ids">
                                        <div class="mt-1">
                                            <span class="badge bg-light text-dark border" style="font-size:.7rem;">
                                                🤝 Connection
                                            </span>
                                        </div>
                                    </t>

                                    <!-- Compatibility score -->
                                    <t t-if="compat_map.get(profile.id)">
                                        <t t-set="_compat" t-value="compat_map[profile.id]"/>
                                        <div class="mt-2">
                                            <div class="progress" style="height:5px; border-radius:3px;">
                                                <div class="progress-bar" role="progressbar" style="background:#e94560;" t-attf-style="width:#{_compat.get('score', 0)}%; background:#e94560;"/>
                                            </div>
                                            <div style="font-size:.7rem; color:#e94560; margin-top:2px;">
                                                Compatibility <t t-out="_compat.get('score', 0)"/>%
                                            </div>
                                        </div>
                                    </t>
                                </div>
                            </a>
                        </div>
                    </t>
                </div>

                <t t-if="not profiles">
                    <div class="text-center py-5 text-muted">
                        <div style="font-size:2rem;">👤</div>
                        <p>No members match these criteria.</p>
                        <a href="/discover" class="btn btn-sm btn-outline-secondary">
                            View all members
                        </a>
                    </div>
                </t>

                <div t-if="pager" class="o_portal_pager text-center">
                    <t t-call="portal.pager"/>
                </div>
            </div>
        </t>
    </template>

</odoo>