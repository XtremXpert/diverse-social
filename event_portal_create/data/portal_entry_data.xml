<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Cartes du portail /my (Odoo 20 : portal.entry remplace les t-call portal_docs_entry) -->
    <record id="portal_entry_my_events" model="portal.entry">
        <field name="name">Mes événements</field>
        <field name="url">/my/events</field>
        <field name="placeholder_count">event_count</field>
        <field name="is_config_card" eval="False"/>
        <field name="sequence" eval="50"/>
    </record>
    <record id="portal_entry_my_become_organiser" model="portal.entry">
        <field name="name">Devenir organisateur</field>
        <field name="url">/my/become-organiser</field>
        <field name="is_config_card" eval="True"/>
        <field name="sequence" eval="51"/>
    </record>
</odoo>
