<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_organiser_request_list" model="ir.ui.view">
        <field name="name">organiser.request.list</field>
        <field name="model">event_portal_create.organiser_request</field>
        <field name="arch" type="xml">
            <list string="Demandes organisateur"
                  decoration-info="state=='pending'"
                  decoration-muted="state in ('approved','rejected')">
                <field name="create_date"/>
                <field name="user_id"/>
                <field name="state"/>
                <field name="reviewer_id"/>
                <field name="reviewed_at"/>
            </list>
        </field>
    </record>

    <record id="view_organiser_request_form" model="ir.ui.view">
        <field name="name">organiser.request.form</field>
        <field name="model">event_portal_create.organiser_request</field>
        <field name="arch" type="xml">
            <form string="Demande organisateur">
                <header>
                    <button name="action_approve" type="object" string="Approuver"
                            class="btn-primary" invisible="state != 'pending'"/>
                    <button name="action_reject" type="object" string="Refuser"
                            invisible="state != 'pending'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,approved,rejected"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="create_date"/>
                        </group>
                        <group>
                            <field name="reviewer_id"/>
                            <field name="reviewed_at"/>
                        </group>
                    </group>
                    <field name="motivation" readonly="1"/>
                    <field name="review_note" placeholder="Note interne (optionnelle)…"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_organiser_request" model="ir.actions.act_window">
        <field name="name">Demandes organisateur</field>
        <field name="res_model">event_portal_create.organiser_request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>

    <record id="view_organiser_request_search" model="ir.ui.view">
        <field name="name">organiser.request.search</field>
        <field name="model">event_portal_create.organiser_request</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/>
                <filter name="pending" string="En attente" domain="[('state','=','pending')]"/>
                <filter name="approved" string="Approuvées" domain="[('state','=','approved')]"/>
                <filter name="rejected" string="Refusées" domain="[('state','=','rejected')]"/>
            </search>
        </field>
    </record>

    <menuitem id="menu_organiser_request" name="Demandes organisateur"
              action="action_organiser_request"
              parent="event.event_main_menu"
              groups="social_base.group_social_moderator"
              sequence="90"/>

</odoo>
