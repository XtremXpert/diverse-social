<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Dispatch the decoupled ntfy outbox. Runs every minute as a
             baseline; notification.create() also calls _trigger() so a push
             goes out within seconds of the in-app notification, without
             blocking the originating request. -->
        <record id="cron_ntfy_dispatch" model="ir.cron">
            <field name="name">Social ntfy: dispatch push outbox</field>
            <field name="model_id" ref="model_social_ntfy_push_outbox"/>
            <field name="state">code</field>
            <field name="code">model._cron_dispatch()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
