<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_club_membership_list" model="ir.ui.view">
        <field name="name">club_membership.membership.list</field>
        <field name="model">club_membership.membership</field>
        <field name="arch" type="xml">
            <list string="Memberships" default_order="start_date desc">
                <field name="partner_id"/>
                <field name="membership_type_id"/>
                <field name="state"
                       decoration-success="state == 'active'"
                       decoration-warning="state in ('pending', 'suspended')"
                       decoration-danger="state in ('expired', 'cancelled')"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="fee_paid"/>
                <field name="invoice_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_club_membership_form" model="ir.ui.view">
        <field name="name">club_membership.membership.form</field>
        <field name="model">club_membership.membership</field>
        <field name="arch" type="xml">
            <form string="Membership">
                <header>
                    <button name="action_activate" string="Activate"
                            type="object" class="btn-primary"
                            invisible="state not in ('pending', 'suspended')"/>
                    <button name="action_suspend" string="Suspend"
                            type="object"
                            invisible="state != 'active'"/>
                    <button name="action_cancel" string="Cancel"
                            type="object"
                            invisible="state in ('cancelled', 'expired')"/>
                    <button name="action_renew" string="Renew"
                            type="object"
                            invisible="state not in ('active', 'expired')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,active,expired"/>
                </header>
                <sheet>
                    <group>
                        <group string="Member">
                            <field name="partner_id"/>
                            <field name="user_id" readonly="1"/>
                            <field name="membership_type_id"/>
                        </group>
                        <group string="Period">
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="fee_paid"/>
                            <field name="invoice_id"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Internal notes..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_club_membership_search" model="ir.ui.view">
        <field name="name">club_membership.membership.search</field>
        <field name="model">club_membership.membership</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="membership_type_id"/>
                <filter name="active" string="Active" domain="[('state','=','active')]"/>
                <filter name="pending" string="Pending" domain="[('state','=','pending')]"/>
                <filter name="expired" string="Expired" domain="[('state','=','expired')]"/>
                <filter name="suspended" string="Suspended" domain="[('state','=','suspended')]"/>
                <group>
                    <filter name="group_type" string="Type"
                            context="{'group_by': 'membership_type_id'}"/>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_club_membership" model="ir.actions.act_window">
        <field name="name">Memberships</field>
        <field name="res_model">club_membership.membership</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_club_membership_search"/>
        <field name="context">{'search_default_active': 1}</field>
    </record>

</odoo>
