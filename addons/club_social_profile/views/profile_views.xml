<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_csp_profile_list" model="ir.ui.view">
            <field name="name">club_social_profile.profile.list</field>
            <field name="model">club_social_profile.profile</field>
            <field name="arch" type="xml">
                <list string="Profiles" default_order="login">
                    <field name="login"/>
                    <field name="pronouns"/>
                    <field name="gender"/>
                    <field name="city"/>
                    <field name="region"/>
                    <field name="onboarding_done"/>
                    <field name="visibility"/>
                </list>
            </field>
        </record>

        <record id="view_csp_profile_form" model="ir.ui.view">
            <field name="name">club_social_profile.profile.form</field>
            <field name="model">club_social_profile.profile</field>
            <field name="arch" type="xml">
                <form string="Member Profile">
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="login" readonly="1"/></h1>
                        </div>
                        <group>
                            <group string="Identity">
                                <field name="user_id" readonly="1"/>
                                <field name="pronouns"/>
                                <field name="birth_year"/>
                                <field name="age" readonly="1"/>
                                <field name="gender"/>
                                <field name="orientation"/>
                            </group>
                            <group string="Location &amp; Status">
                                <field name="city"/>
                                <field name="region"/>
                                <field name="availability"/>
                                <field name="onboarding_done"/>
                                <field name="visibility"/>
                                <field name="age_verified" readonly="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Bio">
                                <field name="bio" nolabel="1"/>
                                <field name="quote"/>
                            </page>
                            <page string="Languages &amp; Goals">
                                <field name="language_ids" widget="many2many_tags"/>
                                <field name="looking_for_ids" widget="many2many_tags"/>
                            </page>
                            <page string="Privacy">
                                <group>
                                    <field name="stealth_name"/>
                                    <field name="allow_link_sharing"/>
                                    <field name="digest_email_enabled"/>
                                </group>
                            </page>
                            <page string="Visits">
                                <field name="profile_view_count" readonly="1"/>
                                <field name="profile_visit_ids">
                                    <list>
                                        <field name="visitor_id"/>
                                        <field name="visited_at"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_csp_profiles" model="ir.actions.act_window">
            <field name="name">Member Profiles</field>
            <field name="res_model">club_social_profile.profile</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_csp_profiles" name="Profiles"
                  parent="social_base.menu_social_base_root"
                  sequence="5"
                  action="action_csp_profiles"/>

        <!-- Connexions -->
        <record id="view_csp_connection_list" model="ir.ui.view">
            <field name="name">club_social_profile.connection.list</field>
            <field name="model">club_social_profile.connection</field>
            <field name="arch" type="xml">
                <list string="Connections" default_order="create_date desc">
                    <field name="user_id"/>
                    <field name="connected_user_id"/>
                    <field name="connection_type"/>
                    <field name="state"/>
                    <field name="create_date"/>
                </list>
            </field>
        </record>

        <record id="action_csp_connections" model="ir.actions.act_window">
            <field name="name">Connections</field>
            <field name="res_model">club_social_profile.connection</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
