<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Default languages -->
        <record id="lang_fr" model="club_social_profile.language">
            <field name="name">French</field>
            <field name="sequence">1</field>
        </record>
        <record id="lang_en" model="club_social_profile.language">
            <field name="name">English</field>
            <field name="sequence">2</field>
        </record>
        <record id="lang_es" model="club_social_profile.language">
            <field name="name">Spanish</field>
            <field name="sequence">3</field>
        </record>

        <!-- What members are looking for -->
        <record id="looking_for_friendship" model="club_social_profile.looking_for">
            <field name="name">Friendship</field>
            <field name="sequence">10</field>
        </record>
        <record id="looking_for_events" model="club_social_profile.looking_for">
            <field name="name">Events / Play parties</field>
            <field name="sequence">20</field>
        </record>
        <record id="looking_for_mentorship" model="club_social_profile.looking_for">
            <field name="name">Mentorship</field>
            <field name="sequence">30</field>
        </record>
        <record id="looking_for_community" model="club_social_profile.looking_for">
            <field name="name">Community</field>
            <field name="sequence">40</field>
        </record>

    </data>
</odoo>
