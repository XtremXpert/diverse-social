<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 
        Website menus for social platform
        These menus appear in the website header navigation
    -->

    <!-- Main Social menu (parent for all social features) -->
    <record id="menu_social_root" model="website.menu">
        <field name="name">Community</field>
        <field name="url">/discover</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence">20</field>
    </record>

    <!-- Discover / Members -->
    <record id="menu_social_discover" model="website.menu">
        <field name="name">Discover</field>
        <field name="url">/discover</field>
        <field name="parent_id" ref="menu_social_root"/>
        <field name="sequence">10</field>
    </record>

    <!-- My Dashboard -->
    <record id="menu_social_dashboard" model="website.menu">
        <field name="name">Dashboard</field>
        <field name="url">/my/dashboard</field>
        <field name="parent_id" ref="menu_social_root"/>
        <field name="sequence">20</field>
    </record>

    <!-- My Profile -->
    <record id="menu_social_profile" model="website.menu">
        <field name="name">My Profile</field>
        <field name="url">/my/profile/edit</field>
        <field name="parent_id" ref="menu_social_root"/>
        <field name="sequence">30</field>
    </record>

</odoo>
