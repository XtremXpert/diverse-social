<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Profiles: read every member profile, write only your own -->
        <record id="profile_user_read_rule" model="ir.rule">
            <field name="name">Club Social Profile: Member Read</field>
            <field name="model_id" ref="model_club_social_profile_profile"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('social_base.group_social_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="profile_user_write_rule" model="ir.rule">
            <field name="name">Club Social Profile: Own Profile Write</field>
            <field name="model_id" ref="model_club_social_profile_profile"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('social_base.group_social_user'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Connections: each user sees their own -->
        <record id="connection_user_rule" model="ir.rule">
            <field name="name">Club Social Connection: User Access</field>
            <field name="model_id" ref="model_club_social_profile_connection"/>
            <field name="domain_force">['|', ('user_id', '=', user.id), ('connected_user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('social_base.group_social_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Notifications: each user sees their own -->
        <record id="notification_user_rule" model="ir.rule">
            <field name="name">Club Social Notification: User Access</field>
            <field name="model_id" ref="model_club_social_profile_notification"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('social_base.group_social_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Moderators see everything -->
        <record id="profile_moderator_rule" model="ir.rule">
            <field name="name">Club Social Profile: Moderator Access</field>
            <field name="model_id" ref="model_club_social_profile_profile"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('social_base.group_social_moderator'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>
