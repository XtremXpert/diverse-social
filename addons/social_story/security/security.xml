<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="social_story_user_rule" model="ir.rule">
            <field name="name">Social Story: User Access</field>
            <field name="model_id" ref="model_social_story_story"/>
            <field name="domain_force">['|', ('state', '=', 'active'), ('author_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('social_base.group_social_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="social_story_moderator_rule" model="ir.rule">
            <field name="name">Social Story: Moderator Access</field>
            <field name="model_id" ref="model_social_story_story"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('social_base.group_social_moderator'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
</odoo>
