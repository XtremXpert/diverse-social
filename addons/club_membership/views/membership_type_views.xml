<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_club_membership_type_list" model="ir.ui.view">
        <field name="name">club_membership.type.list</field>
        <field name="model">club_membership.type</field>
        <field name="arch" type="xml">
            <list string="Membership types" editable="top">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="duration_months"/>
                <field name="fee"/>
                <field name="membership_count" string="Memberships"/>
                <field name="active" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_club_membership_type_form" model="ir.ui.view">
        <field name="name">club_membership.type.form</field>
        <field name="model">club_membership.type</field>
        <field name="arch" type="xml">
            <form string="Membership type">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nom du type..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="fee"/>
                            <field name="duration_months"
                                   help="0 = unlimited (lifetime member)"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="membership_count" string="Active memberships"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Public description..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_club_membership_type" model="ir.actions.act_window">
        <field name="name">Membership types</field>
        <field name="res_model">club_membership.type</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
