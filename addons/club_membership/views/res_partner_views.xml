<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_membership_ext" model="ir.ui.view">
        <field name="name">res.partner.form.club_membership</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Membership" name="club_membership">
                    <group>
                        <field name="member_state" readonly="1"/>
                        <field name="current_membership_id" readonly="1"/>
                    </group>
                    <field name="membership_ids" readonly="1">
                        <list>
                            <field name="membership_type_id"/>
                            <field name="state"
                                   decoration-success="state == 'active'"
                                   decoration-warning="state in ('pending', 'suspended')"
                                   decoration-danger="state in ('expired', 'cancelled')"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="fee_paid"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
