<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_product_template_form_membership_ext" model="ir.ui.view">
        <field name="name">product.template.form.club_membership_sale</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='description_sale']" position="before">
                <field name="membership_type_id"
                       string="Membership type"
                       help="If set, selling this product automatically creates a membership."/>
            </xpath>
        </field>
    </record>

</odoo>
