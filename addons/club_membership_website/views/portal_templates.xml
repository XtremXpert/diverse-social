<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Portal menu entry -->
    <template id="portal_my_home_membership" name="Portal: memberships" inherit_id="portal.portal_my_home" priority="30">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">My memberships</t>
                <t t-set="url">/my/membership</t>
                <t t-set="placeholder_count">membership_count</t>
            </t>
        </xpath>
    </template>

    <!-- Breadcrumb for membership pages -->
    <template id="portal_breadcrumb_membership" name="Membership breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a href="/my/home">My account</a>
            </li>
            <li class="breadcrumb-item">
                <a href="/my/membership">My memberships</a>
            </li>
            <li t-if="membership" class="breadcrumb-item active">
                <t t-esc="membership.membership_type_id.name"/>
            </li>
        </ol>
    </template>

    <!-- Memberships list -->
    <template id="portal_my_memberships" name="Portal — My memberships">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">My memberships</t>
            </t>

            <t t-if="not memberships">
                <div class="alert alert-info">
                    You don't have a membership yet.
                    <a href="/membership" class="alert-link">View available plans</a>
                </div>
            </t>

            <t t-if="memberships">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Type</th>
                            <th>State</th>
                            <th>Start</th>
                            <th>End</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="memberships" t-as="m">
                            <tr>
                                <td><t t-esc="m.membership_type_id.name"/></td>
                                <td>
                                    <span t-att-class="'badge rounded-pill ' + {'active': 'bg-success', 'pending': 'bg-warning text-dark', 'expired': 'bg-secondary', 'suspended': 'bg-warning text-dark', 'cancelled': 'bg-danger'}.get(m.state, 'bg-secondary')">
                                        <t t-esc="m.state"/>
                                    </span>
                                </td>
                                <td><t t-esc="m.start_date"/></td>
                                <td>
                                    <t t-if="m.end_date"><t t-esc="m.end_date"/></t>
                                    <t t-else=""><span class="text-muted">—</span></t>
                                </td>
                                <td>
                                    <a t-attf-href="/my/membership/#{m.id}" class="btn btn-sm btn-outline-primary">
                                        View
                                    </a>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <div t-if="pager" class="o_portal_pager text-center">
                    <t t-call="portal.pager"/>
                </div>
            </t>
        </t>
    </template>

    <!-- Membership detail -->
    <template id="portal_membership_detail" name="Portal — Membership detail">
        <t t-call="portal.portal_layout">
            <t t-call="club_membership_website.portal_breadcrumb_membership"/>

            <div class="card">
                <div class="card-header">
                    <h4 class="mb-0">
                        <t t-esc="membership.membership_type_id.name"/>
                    </h4>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">State</dt>
                        <dd class="col-sm-8">
                            <span t-att-class="'badge rounded-pill ' + {'active': 'bg-success', 'pending': 'bg-warning text-dark', 'expired': 'bg-secondary', 'suspended': 'bg-warning text-dark', 'cancelled': 'bg-danger'}.get(membership.state, 'bg-secondary')">
                                <t t-esc="membership.state"/>
                            </span>
                        </dd>

                        <dt class="col-sm-4">Start date</dt>
                        <dd class="col-sm-8"><t t-esc="membership.start_date"/></dd>

                        <dt class="col-sm-4">End date</dt>
                        <dd class="col-sm-8">
                            <t t-if="membership.end_date"><t t-esc="membership.end_date"/></t>
                            <t t-else=""><span class="text-muted">Unlimited</span></t>
                        </dd>

                        <dt class="col-sm-4" t-if="membership.fee_paid">Membership fee paid</dt>
                        <dd class="col-sm-8" t-if="membership.fee_paid">
                            <t t-esc="'{:,.2f}'.format(membership.fee_paid)"/>
                            <t t-esc="membership.currency_id.symbol"/>
                        </dd>
                    </dl>
                </div>

                <div class="card-footer d-flex gap-2" t-if="renewal_product and membership.state in ('active', 'expired')">
                    <form t-attf-action="/my/membership/#{membership.id}/renew" method="post">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <button type="submit" class="btn btn-primary">
                            Renew
                        </button>
                    </form>
                </div>
            </div>

            <div class="mt-3">
                <a href="/my/membership" class="btn btn-link ps-0">
                    ← Back to my memberships
                </a>
            </div>
        </t>
    </template>

</odoo>
