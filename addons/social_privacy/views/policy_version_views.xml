<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_policy_version_list" model="ir.ui.view">
        <field name="name">social_privacy.policy.version.list</field>
        <field name="model">social_privacy.policy.version</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="version_number"/>
                <field name="effective_date"/>
                <field name="language"/>
                <field name="is_active"/>
                <field name="consent_count"/>
            </list>
        </field>
    </record>

    <record id="view_policy_version_form" model="ir.ui.view">
        <field name="name">social_privacy.policy.version.form</field>
        <field name="model">social_privacy.policy.version</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_set_active" string="Set Active" type="object" invisible="is_active"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="version_number"/>
                            <field name="effective_date"/>
                        </group>
                        <group>
                            <field name="language"/>
                            <field name="is_active"/>
                            <field name="consent_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Policy Text">
                            <field name="content" widget="html"/>
                        </page>
                        <page string="Consents">
                            <field name="consent_ids" readonly="1">
                                <list>
                                    <field name="user_id"/>
                                    <field name="state"/>
                                    <field name="consented_at"/>
                                    <field name="source"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_policy_version" model="ir.actions.act_window">
        <field name="name">Privacy Policy Versions</field>
        <field name="res_model">social_privacy.policy.version</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_policy_version"
              name="Policy Versions"
              parent="social_privacy.menu_privacy_root"
              action="action_policy_version"
              sequence="10"/>
</odoo>
