<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Camouflaged defaults, matching the existing social_safety quick-exit
             persona (MétéoMédia / Prévisions Québec). Override in any deployment
             that prefers an explicit brand. -->
        <record id="param_app_name" model="ir.config_parameter">
            <field name="key">social_pwa.app_name</field>
            <field name="value">MétéoMédia</field>
        </record>

        <record id="param_app_short_name" model="ir.config_parameter">
            <field name="key">social_pwa.app_short_name</field>
            <field name="value">Météo</field>
        </record>

        <record id="param_app_description" model="ir.config_parameter">
            <field name="key">social_pwa.app_description</field>
            <field name="value">Prévisions et alertes météo régionales</field>
        </record>

        <record id="param_theme_color" model="ir.config_parameter">
            <field name="key">social_pwa.theme_color</field>
            <field name="value">#5fa8d3</field>
        </record>

        <record id="param_background_color" model="ir.config_parameter">
            <field name="key">social_pwa.background_color</field>
            <field name="value">#ffffff</field>
        </record>

        <record id="param_start_url" model="ir.config_parameter">
            <field name="key">social_pwa.start_url</field>
            <field name="value">/my/dashboard</field>
        </record>

        <!-- Generic push payload, identical for every notification. -->
        <record id="param_push_title" model="ir.config_parameter">
            <field name="key">social_pwa.push_title</field>
            <field name="value">MétéoMédia</field>
        </record>

        <record id="param_push_body" model="ir.config_parameter">
            <field name="key">social_pwa.push_body</field>
            <field name="value">Nouvelle activité — ouvrez l'app pour voir.</field>
        </record>

    </data>
</odoo>
