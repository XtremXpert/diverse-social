<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- 6 catégories de propositions citoyennes adaptées à une
             municipalité rurale. min_quorum dimensionné selon l'impact :
             50 pour les sujets engageants (consultation municipale,
             budget participatif), 30 pour le quotidien, 0 pour la pure
             consultation symbolique. -->

        <record id="category_voirie" model="social_governance.proposal_category">
            <field name="name">Voirie et infrastructure</field>
            <field name="sequence">10</field>
            <field name="color">2</field>
            <field name="min_quorum">30</field>
        </record>

        <record id="category_loisirs" model="social_governance.proposal_category">
            <field name="name">Loisirs et vie sociale</field>
            <field name="sequence">20</field>
            <field name="color">3</field>
            <field name="min_quorum">30</field>
        </record>

        <record id="category_environnement" model="social_governance.proposal_category">
            <field name="name">Environnement</field>
            <field name="sequence">30</field>
            <field name="color">4</field>
            <field name="min_quorum">30</field>
        </record>

        <record id="category_budget_participatif" model="social_governance.proposal_category">
            <field name="name">Budget participatif</field>
            <field name="sequence">40</field>
            <field name="color">5</field>
            <field name="min_quorum">50</field>
        </record>

        <record id="category_vie_communautaire" model="social_governance.proposal_category">
            <field name="name">Vie communautaire (consultation)</field>
            <field name="sequence">50</field>
            <field name="color">6</field>
            <field name="min_quorum">0</field>
        </record>

        <record id="category_consultation_municipale" model="social_governance.proposal_category">
            <field name="name">Consultation municipale officielle</field>
            <field name="sequence">60</field>
            <field name="color">7</field>
            <field name="min_quorum">50</field>
        </record>
    </data>
</odoo>
