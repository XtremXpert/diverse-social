<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- 5 catégories de posts pour orienter le fil communautaire.
             Codes stables (l'API les utilise) ; libellés français pour la
             communauté de St-Isidore. Émojis utilisés à la place de
             FontAwesome — autonomes, lisibles partout. -->

        <record id="category_annonce" model="social_post_categories.category">
            <field name="name">Annonce</field>
            <field name="code">annonce</field>
            <field name="icon">📣</field>
            <field name="color">#0d6efd</field>
            <field name="sequence">10</field>
            <field name="description">Information générale (horaire, événement à venir, changement administratif).</field>
        </record>

        <record id="category_alerte" model="social_post_categories.category">
            <field name="name">Alerte</field>
            <field name="code">alerte</field>
            <field name="icon">🚨</field>
            <field name="color">#dc3545</field>
            <field name="sequence">20</field>
            <field name="description">Information urgente (panne d'eau, fermeture de chemin, météo extrême). Push prioritaire.</field>
        </record>

        <record id="category_entraide" model="social_post_categories.category">
            <field name="name">Entraide</field>
            <field name="code">entraide</field>
            <field name="icon">🤝</field>
            <field name="color">#198754</field>
            <field name="sequence">30</field>
            <field name="description">Coup de main demandé ou offert : pelletage, transport, prêt d'outil.</field>
        </record>

        <record id="category_question" model="social_post_categories.category">
            <field name="name">Question</field>
            <field name="code">question</field>
            <field name="icon">❓</field>
            <field name="color">#ffc107</field>
            <field name="sequence">40</field>
            <field name="description">Sollicite l'expérience ou l'avis des voisins.</field>
        </record>

        <record id="category_evenement" model="social_post_categories.category">
            <field name="name">Évènement</field>
            <field name="code">evenement</field>
            <field name="icon">📅</field>
            <field name="color">#6f42c1</field>
            <field name="sequence">50</field>
            <field name="description">Activité communautaire à venir : fête, AGA, marché, partie de cartes.</field>
        </record>
    </data>
</odoo>
