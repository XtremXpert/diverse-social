<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Override des paramètres city_club créés vides par le module générique.
             On référence leurs XML IDs (city_club.param_*) pour UPDATE plutôt
             que INSERT — sinon la contrainte unique sur ir.config_parameter.key
             rejette l'install. -->
        <record id="city_club.param_city_name" model="ir.config_parameter">
            <field name="value">St-Isidore-de-Beauce</field>
        </record>
        <!-- Codes postaux du village. Préfixe G0S couvre G0S 2S0 et les rangs
             limitrophes. Affiner avec une liste exacte si trop de bruit. -->
        <record id="city_club.param_allowed_postal_prefix" model="ir.config_parameter">
            <field name="value">G0S</field>
        </record>
        <!-- Centre géographique du village (église St-Isidore) -->
        <record id="city_club.param_map_center_lat" model="ir.config_parameter">
            <field name="value">46.3478</field>
        </record>
        <record id="city_club.param_map_center_lng" model="ir.config_parameter">
            <field name="value">-70.9836</field>
        </record>
        <record id="city_club.param_map_default_radius_km" model="ir.config_parameter">
            <field name="value">8</field>
        </record>

        <!-- Paramètres propres au leaf — clés non créées ailleurs, INSERT OK. -->
        <record id="param_site_name_alias" model="ir.config_parameter">
            <field name="key">st_isidore_city_club.site_name</field>
            <field name="value">St-Isidore communauté</field>
        </record>
        <record id="param_digest_from_email" model="ir.config_parameter">
            <field name="key">st_isidore_city_club.digest_from_email</field>
            <field name="value">noreply@stisidore.example</field>
        </record>
    </data>
</odoo>
