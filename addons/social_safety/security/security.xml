<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Only the blocker can see their own blocks -->
        <record id="rule_block_own" model="ir.rule">
            <field name="name">Social Block: own only</field>
            <field name="model_id" ref="model_social_safety_block"/>
            <field name="domain_force">[('blocker_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('social_base.group_social_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Only the muter can see their own mutes -->
        <record id="rule_mute_own" model="ir.rule">
            <field name="name">Social Mute: own only</field>
            <field name="model_id" ref="model_social_safety_mute"/>
            <field name="domain_force">[('muter_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('social_base.group_social_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>
