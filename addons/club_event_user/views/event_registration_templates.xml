<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- Injecter le sélecteur de membre dans le formulaire d'inscription
     quand require_member_name est coché sur le type de billet.
     Positionné après l'input caché event_ticket_id, dans la boucle par inscrit. -->
<template id="registration_attendee_member_selector"
          inherit_id="website_event.registration_attendee_details">
    <xpath expr="//input[@class='d-none'][@type='text']" position="after">
        <t t-set="ticket_rec" t-value="request.env['event.event.ticket'].sudo().browse(ticket['id'])"/>
        <t t-if="ticket_rec.require_member_name">
            <t t-set="all_members" t-value="request.env['res.users'].sudo().search([('share', '=', False), ('active', '=', True)], order='login')"/>
            <t t-set="current_uid" t-value="0 if request.env.user._is_public() else request.env.user.id"/>
            <div class="modal-body">
                <h5 class="mt-1 pb-2 border-bottom">
                    Billet <span t-out="counter"/> <small class="text-muted">— <span t-out="ticket['name']"/></small>
                </h5>
                <div class="row">
                    <div class="col-lg-6 mt-2">
                        <label class="form-label fw-bold">Membre *</label>
                        <select class="form-select"
                                t-attf-name="#{counter}-user_id"
                                required="required">
                            <option value="">— Choisir un membre —</option>
                            <t t-foreach="all_members" t-as="member">
                                <option t-att-value="member.id"
                                        t-att-selected="'selected' if (counter in (0, 1) and member.id == current_uid) else None">
                                    <t t-out="member.login"/>
                                </option>
                            </t>
                        </select>
                    </div>
                </div>
            </div>
        </t>
    </xpath>
</template>

</odoo>
