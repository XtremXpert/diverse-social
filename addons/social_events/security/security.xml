<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Club members get base event access (can see events and register) -->
        <record id="social_base.group_social_user" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('event.group_event_registration_desk'))]"/>
        </record>
        <!-- Moderators creating events need event.user access -->
        <record id="social_base.group_social_moderator" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('event.group_event_user'))]"/>
        </record>
    </data>
    <data noupdate="1">

        <!--
            Social members see:
            - events without social_visibility set (non-social events)
            - events open to all members
            - circle-gated events where they belong to an allowed circle
        -->
        <record id="rule_event_social_visibility" model="ir.rule">
            <field name="name">Event: social visibility filter</field>
            <field name="model_id" ref="event.model_event_event"/>
            <field name="domain_force">
                ['|',
                 ('social_visibility', '=', False),
                 '|',
                 ('social_visibility', '=', 'members'),
                 ('allowed_circle_ids.member_ids', 'in', [user.id])]
            </field>
            <field name="groups" eval="[(4, ref('social_base.group_social_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Organizer (moderator) can edit their own events -->
        <record id="rule_event_organizer_write" model="ir.rule">
            <field name="name">Event: organizer can edit</field>
            <field name="model_id" ref="event.model_event_event"/>
            <field name="domain_force">[('organizer_user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('social_base.group_social_moderator'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>
