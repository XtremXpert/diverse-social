<?xml version="1.0" encoding="utf-8"?>
<odoo>

<record id="view_blog_blog_form_restricted" model="ir.ui.view">
    <field name="name">blog.blog.form.restricted</field>
    <field name="model">blog.blog</field>
    <field name="inherit_id" ref="website_blog.view_blog_blog_form"/>
    <field name="arch" type="xml">
        <field name="website_id" position="after">
            <field name="owner_partner_id"
                   placeholder="Optionnel — requis pour les niveaux Connexions et Relations"/>
            <field name="visibility" widget="radio"/>
            <field name="allowed_relation_type_ids"
                   widget="many2many_tags"
                   options="{'no_create': True}"
                   attrs="{'invisible': [('visibility', '!=', 'relations')]}"/>
        </field>
    </field>
</record>

</odoo>
