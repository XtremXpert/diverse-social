<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Users see all proposals (governance is community-wide) -->
        <!-- Votes: each user sees only their own -->
        <record id="rule_vote_own" model="ir.rule">
            <field name="name">Vote: own only</field>
            <field name="model_id" ref="model_social_governance_vote"/>
            <field name="domain_force">[('voter_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('social_base.group_social_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>
