<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══ Entrée portail home ════════════════════════════════════════════ -->
    <template id="portal_my_home_governance" name="Portal My Home: Governance"
              inherit_id="portal.portal_my_home" priority="35">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-if="proposals_voting_count is not None">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="title">Propositions en vote</t>
                    <t t-set="url">/governance</t>
                    <t t-set="count" t-value="proposals_voting_count"/>
                </t>
            </t>
        </xpath>
    </template>

    <!-- ══ Liste des propositions ════════════════════════════════════════════ -->
    <template id="portal_governance_list" name="Gouvernance communautaire">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="False"/>

            <div class="container py-4" style="max-width:860px;">
                <h1 class="mb-4" style="font-size:1.5rem; color:#1a1a2e;">⚖️ Gouvernance communautaire</h1>

                <!-- Alertes -->
                <t t-if="error or request.params.get('error')">
                    <div class="alert alert-danger" t-esc="error or request.params.get('error')"/>
                </t>

                <!-- ── Filtres état ────────────────────────────────────── -->
                <div class="d-flex flex-wrap gap-1 mb-4">
                    <t t-foreach="[('voting','En vote'),('open','Ouvert'),('draft','Brouillon'),('accepted','Acceptée'),('rejected','Rejetée')]" t-as="st">
                        <a t-attf-href="/governance?state=#{st[0]}"
                           t-attf-class="btn btn-sm #{state_filter == st[0] and 'text-white' or 'btn-outline-secondary'}"
                           t-attf-style="#{state_filter == st[0] and 'background:#1a1a2e;' or ''}">
                            <t t-esc="st[1]"/>
                        </a>
                    </t>
                </div>

                <!-- ── Créer une proposition (collapse) ───────────────── -->
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="mb-0" style="color:#1a1a2e;">Propositions</h5>
                    <button class="btn btn-sm" style="background:#e94560;color:white;"
                            data-bs-toggle="collapse" data-bs-target="#sn_create_proposal">
                        + Nouvelle proposition
                    </button>
                </div>
                <div class="collapse mb-4" id="sn_create_proposal">
                    <div class="card card-body">
                        <form action="/governance/create" method="post">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <div class="mb-2">
                                <input type="text" name="name" class="form-control form-control-sm"
                                       placeholder="Titre de la proposition" required="required" maxlength="200"/>
                            </div>
                            <div class="mb-2">
                                <textarea name="description" class="form-control form-control-sm" rows="4"
                                          placeholder="Description détaillée" required="required" maxlength="5000"/>
                            </div>
                            <div class="row g-2 mb-2">
                                <div class="col-md-6">
                                    <select name="category_id" class="form-select form-select-sm" required="required">
                                        <option value="">— Catégorie —</option>
                                        <t t-foreach="categories" t-as="cat">
                                            <option t-att-value="cat.id" t-esc="cat.name"/>
                                        </t>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <input type="datetime-local" name="voting_closes_at"
                                           class="form-control form-control-sm"
                                           title="Date de clôture du vote (optionnel)"/>
                                </div>
                            </div>
                            <button type="submit" class="btn btn-sm"
                                    style="background:#1a1a2e;color:white;">
                                Soumettre la proposition
                            </button>
                        </form>
                    </div>
                </div>

                <!-- ── Liste propositions ─────────────────────────────── -->
                <div class="list-group shadow-sm mb-4">
                    <t t-foreach="proposals" t-as="proposal">
                        <a t-attf-href="/governance/#{proposal.id}"
                           class="list-group-item list-group-item-action py-3 text-decoration-none">
                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                <div class="flex-grow-1">
                                    <div class="fw-semibold" style="color:#1a1a2e;">
                                        <t t-esc="proposal.name"/>
                                    </div>
                                    <small class="text-muted">
                                        Par <t t-esc="proposal.author_id.name"/> ·
                                        <t t-esc="proposal.category_id.name"/>
                                    </small>
                                    <!-- Barre de vote si en cours -->
                                    <t t-if="proposal.state == 'voting' and proposal.vote_count > 0">
                                        <div class="progress mt-2" style="height:6px;">
                                            <div class="progress-bar bg-success" role="progressbar"
                                                 t-attf-style="width:#{proposal.approval_pct}%"/>
                                            <div class="progress-bar bg-danger" role="progressbar"
                                                 t-attf-style="width:#{100 - proposal.approval_pct}%"/>
                                        </div>
                                        <small class="text-muted" style="font-size:.75rem;">
                                            <span class="text-success"><t t-esc="proposal.yes_count"/> pour</span> ·
                                            <span class="text-danger"><t t-esc="proposal.no_count"/> contre</span> ·
                                            <t t-esc="proposal.abstain_count"/> abstentions
                                        </small>
                                    </t>
                                </div>
                                <div class="text-end flex-shrink-0">
                                    <span t-attf-class="badge #{proposal.state == 'voting' and 'bg-warning text-dark' or proposal.state == 'accepted' and 'bg-success' or proposal.state == 'rejected' and 'bg-danger' or 'bg-secondary'}">
                                        <t t-esc="state_labels.get(proposal.state, proposal.state)"/>
                                    </span>
                                    <t t-if="proposal.state == 'voting' and proposal.voting_closes_at">
                                        <div class="text-muted" style="font-size:.72rem; margin-top:2px;">
                                            Clôture :
                                            <span t-field="proposal.voting_closes_at" t-options='{"widget":"date"}'/>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </a>
                    </t>
                </div>

                <t t-if="not proposals">
                    <p class="text-muted text-center py-4">Aucune proposition dans cet état.</p>
                </t>

                <div t-if="pager" class="o_portal_pager text-center mb-4">
                    <t t-call="portal.pager"/>
                </div>

                <div class="text-center">
                    <a href="/governance/log" class="btn btn-sm btn-outline-secondary">
                        📋 Journal des décisions
                    </a>
                </div>
            </div>
        </t>
    </template>

    <!-- ══ Détail proposition ═════════════════════════════════════════════════ -->
    <template id="portal_governance_detail" name="Proposition — détail">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="False"/>

            <div class="container py-4" style="max-width:780px;">

                <!-- Fil d'Ariane -->
                <nav aria-label="breadcrumb" class="mb-3">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a href="/governance" style="color:#e94560;">Gouvernance</a>
                        </li>
                        <li class="breadcrumb-item active text-truncate" style="max-width:300px;">
                            <t t-esc="proposal.name"/>
                        </li>
                    </ol>
                </nav>

                <!-- Alertes -->
                <t t-if="request.params.get('voted')">
                    <div class="alert alert-success">Vote enregistré.</div>
                </t>
                <t t-if="request.params.get('withdrawn')">
                    <div class="alert alert-info">Proposition retirée.</div>
                </t>
                <t t-if="request.params.get('created')">
                    <div class="alert alert-success">Proposition soumise avec succès.</div>
                </t>
                <t t-if="request.params.get('opened')">
                    <div class="alert alert-success">Proposition ouverte à la discussion.</div>
                </t>
                <t t-if="request.params.get('voting_started')">
                    <div class="alert alert-success">Vote lancé avec succès.</div>
                </t>
                <t t-if="error or request.params.get('error')">
                    <div class="alert alert-danger" t-esc="error or request.params.get('error')"/>
                </t>

                <!-- ── En-tête ─────────────────────────────────────────── -->
                <div class="card mb-4" style="border-top:4px solid #1a1a2e;">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
                            <h2 style="font-size:1.25rem; color:#1a1a2e; margin-bottom:0;">
                                <t t-esc="proposal.name"/>
                            </h2>
                            <div class="d-flex gap-2 align-items-center">
                                <span t-attf-class="badge #{proposal.state == 'voting' and 'bg-warning text-dark' or proposal.state == 'accepted' and 'bg-success' or proposal.state == 'rejected' and 'bg-danger' or 'bg-secondary'}">
                                    <t t-esc="state_labels.get(proposal.state, proposal.state)"/>
                                </span>
                                <!-- Ouvrir (auteur ou modérateur, brouillon uniquement) -->
                                <t t-if="(is_author or is_moderator) and proposal.state == 'draft'">
                                    <form t-attf-action="/governance/#{proposal.id}/open" method="post"
                                          class="d-inline">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <button type="submit" class="btn btn-sm btn-outline-primary"
                                                style="font-size:.75rem;">
                                            Ouvrir
                                        </button>
                                    </form>
                                </t>
                                <!-- Lancer le vote (auteur ou modérateur, brouillon ou ouvert) -->
                                <t t-if="(is_author or is_moderator) and proposal.state in ('draft', 'open')">
                                    <form t-attf-action="/governance/#{proposal.id}/start_voting" method="post"
                                          class="d-inline">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <input type="datetime-local" name="voting_closes_at"
                                               class="form-control-sm d-inline-block"
                                               style="width:auto; font-size:.75rem;"
                                               title="Date de clôture du vote"/>
                                        <button type="submit" class="btn btn-sm"
                                                style="background:#1a1a2e;color:white;font-size:.75rem;">
                                            Lancer le vote
                                        </button>
                                    </form>
                                </t>
                                <!-- Retirer (auteur ou modérateur) -->
                                <t t-if="(is_author or is_moderator) and proposal.state not in ('accepted','rejected','withdrawn')">
                                    <form t-attf-action="/governance/#{proposal.id}/withdraw" method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Retirer cette proposition ?')">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <button type="submit" class="btn btn-sm btn-outline-secondary"
                                                style="font-size:.75rem;">
                                            Retirer
                                        </button>
                                    </form>
                                </t>
                            </div>
                        </div>
                        <p class="text-muted mb-0" style="font-size:.85rem;">
                            Par <strong t-esc="proposal.author_id.name"/> ·
                            <t t-esc="proposal.category_id.name"/> ·
                            <span t-field="proposal.create_date" t-options='{"widget":"date"}'/>
                        </p>
                    </div>
                </div>

                <!-- ── Description ─────────────────────────────────────── -->
                <div class="card mb-4">
                    <div class="card-body">
                        <div t-raw="proposal.description"/>
                    </div>
                </div>

                <!-- ── Bloc vote (si en cours) ─────────────────────────── -->
                <t t-if="proposal.state == 'voting'">
                    <div class="card mb-4" style="border-left:4px solid #e94560;">
                        <div class="card-header fw-bold" style="background:#1a1a2e;color:white;">
                            🗳️ Vote en cours
                            <t t-if="deadline_hours is not None">
                                <span class="float-end fw-normal" style="font-size:.8rem;">
                                    <t t-if="deadline_hours == 0">Clôture imminente</t>
                                    <t t-elif="deadline_hours &lt; 24"><t t-esc="deadline_hours"/>h restantes</t>
                                    <t t-else=""><t t-esc="deadline_hours // 24"/>j restants</t>
                                </span>
                            </t>
                        </div>
                        <div class="card-body">
                            <!-- Barre de résultats -->
                            <t t-if="proposal.vote_count > 0">
                                <div class="progress mb-2" style="height:16px; border-radius:8px;">
                                    <div class="progress-bar bg-success fw-bold"
                                         t-attf-style="width:#{proposal.approval_pct}%"
                                         t-esc="proposal.approval_pct > 10 and str(proposal.approval_pct) + '%' or ''"/>
                                    <div class="progress-bar bg-danger fw-bold"
                                         t-attf-style="width:#{100 - proposal.approval_pct}%"
                                         t-esc="(100 - proposal.approval_pct) > 10 and str(100 - proposal.approval_pct) + '%' or ''"/>
                                </div>
                                <div class="d-flex justify-content-between mb-3" style="font-size:.85rem;">
                                    <span class="text-success fw-bold">
                                        <t t-esc="proposal.yes_count"/> pour
                                    </span>
                                    <span class="text-muted">
                                        <t t-esc="proposal.abstain_count"/> abstentions
                                    </span>
                                    <span class="text-danger fw-bold">
                                        <t t-esc="proposal.no_count"/> contre
                                    </span>
                                </div>
                            </t>
                            <t t-else="">
                                <p class="text-muted mb-3">Aucun vote pour l'instant.</p>
                            </t>

                            <!-- Mon vote actuel -->
                            <t t-if="my_vote">
                                <div class="alert alert-info py-2 mb-3" style="font-size:.85rem;">
                                    Votre vote actuel :
                                    <strong t-esc="my_vote == 'yes' and 'Pour' or my_vote == 'no' and 'Contre' or 'Abstention'"/>
                                    — vous pouvez le modifier.
                                </div>
                            </t>

                            <!-- Formulaire de vote -->
                            <form t-attf-action="/governance/#{proposal.id}/vote" method="post">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <div class="d-flex gap-2 flex-wrap">
                                    <button type="submit" name="choice" value="yes"
                                            t-attf-class="btn btn-sm #{my_vote == 'yes' and 'btn-success' or 'btn-outline-success'}">
                                        ✓ Pour
                                    </button>
                                    <button type="submit" name="choice" value="no"
                                            t-attf-class="btn btn-sm #{my_vote == 'no' and 'btn-danger' or 'btn-outline-danger'}">
                                        ✗ Contre
                                    </button>
                                    <button type="submit" name="choice" value="abstain"
                                            t-attf-class="btn btn-sm #{my_vote == 'abstain' and 'btn-secondary' or 'btn-outline-secondary'}">
                                        ○ Abstention
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </t>

                <!-- ── Résultats finaux (acceptée / rejetée) ───────────── -->
                <t t-elif="proposal.state in ('accepted', 'rejected')">
                    <div t-attf-class="card mb-4 border-left-0"
                         t-attf-style="border-left:4px solid #{proposal.state == 'accepted' and '#27ae60' or '#e94560'};">
                        <div t-attf-class="card-header fw-bold"
                             t-attf-style="background:#{proposal.state == 'accepted' and '#27ae60' or '#e94560'};color:white;">
                            <t t-esc="proposal.state == 'accepted' and '✓ Proposition acceptée' or '✗ Proposition rejetée'"/>
                        </div>
                        <div class="card-body">
                            <t t-if="proposal.vote_count > 0">
                                <div class="progress mb-2" style="height:16px; border-radius:8px;">
                                    <div class="progress-bar bg-success"
                                         t-attf-style="width:#{proposal.approval_pct}%"/>
                                    <div class="progress-bar bg-danger"
                                         t-attf-style="width:#{100 - proposal.approval_pct}%"/>
                                </div>
                                <div class="d-flex justify-content-between" style="font-size:.85rem;">
                                    <span class="text-success fw-bold"><t t-esc="proposal.yes_count"/> pour</span>
                                    <span class="text-muted"><t t-esc="proposal.abstain_count"/> abstentions</span>
                                    <span class="text-danger fw-bold"><t t-esc="proposal.no_count"/> contre</span>
                                </div>
                            </t>
                            <t t-else="">
                                <span class="text-muted">Aucun vote enregistré.</span>
                            </t>
                        </div>
                    </div>
                </t>

                <div class="text-center mt-3">
                    <a href="/governance" class="btn btn-sm btn-outline-secondary">
                        ← Retour aux propositions
                    </a>
                </div>
            </div>
        </t>
    </template>

    <!-- ══ Journal des décisions ═════════════════════════════════════════════ -->
    <template id="portal_governance_log" name="Journal des décisions">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="False"/>

            <div class="container py-4" style="max-width:780px;">
                <h1 class="mb-1" style="font-size:1.5rem; color:#1a1a2e;">📋 Journal des décisions</h1>
                <p class="text-muted mb-4">Décisions publiques prises par les modérateurs.</p>

                <div class="list-group shadow-sm mb-4">
                    <t t-foreach="entries" t-as="entry">
                        <div class="list-group-item py-3">
                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                <div>
                                    <div class="fw-semibold" style="color:#1a1a2e;" t-esc="entry.title"/>
                                    <small class="text-muted">
                                        <span t-field="entry.decision_date" t-options='{"widget":"date"}'/> ·
                                        <t t-esc="entry.category"/>
                                    </small>
                                </div>
                            </div>
                            <div t-raw="entry.body" class="mt-2" style="font-size:.9rem;"/>
                        </div>
                    </t>
                </div>

                <t t-if="not entries">
                    <p class="text-muted text-center py-4">Aucune décision publiée.</p>
                </t>

                <div t-if="pager" class="o_portal_pager text-center mb-4">
                    <t t-call="portal.pager"/>
                </div>

                <div class="text-center">
                    <a href="/governance" class="btn btn-sm btn-outline-secondary">
                        ← Retour aux propositions
                    </a>
                </div>
            </div>
        </t>
    </template>

</odoo>
