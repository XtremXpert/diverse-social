<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_discovery_criteria_form" model="ir.ui.view">
        <field name="name">social_discovery.criteria.form</field>
        <field name="model">social_discovery.criteria</field>
        <field name="arch" type="xml">
            <form string="Search Criteria">
                <header>
                    <button name="action_search" type="object" string="Search"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <field name="is_default"/>
                        <field name="result_count" readonly="1"/>
                    </group>
                    <group string="Age &amp; Location">
                        <group>
                            <field name="min_age"/>
                            <field name="max_age" placeholder="0 = no limit"/>
                        </group>
                        <group>
                            <field name="city" placeholder="Partial city name…"/>
                        </group>
                    </group>
                    <group string="Identity">
                        <field name="gender_ids" widget="many2many_tags"/>
                        <field name="orientation_ids" widget="many2many_tags"/>
                        <field name="availability_ids" widget="many2many_tags"/>
                    </group>
                    <group string="Profile Content">
                        <field name="looking_for_ids" widget="many2many_tags"/>
                        <field name="language_ids" widget="many2many_tags"/>
                    </group>
                    <group string="Filters">
                        <group>
                            <field name="has_photo"/>
                            <field name="age_verified"/>
                            <field name="onboarding_done"/>
                        </group>
                        <group>
                            <field name="reachable_only"/>
                            <field name="in_circles_only"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_discovery_criteria_list" model="ir.ui.view">
        <field name="name">social_discovery.criteria.list</field>
        <field name="model">social_discovery.criteria</field>
        <field name="arch" type="xml">
            <list string="Saved Searches">
                <field name="name"/>
                <field name="is_default"/>
                <field name="city"/>
                <field name="min_age"/>
                <field name="max_age"/>
                <field name="result_count"/>
            </list>
        </field>
    </record>

    <record id="action_my_searches" model="ir.actions.act_window">
        <field name="name">My Searches</field>
        <field name="res_model">social_discovery.criteria</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('profile_id.user_id', '=', uid)]</field>
    </record>

</odoo>
