<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!--
        Types de relations entre membres — Club l'Orage
        ─────────────────────────────────────────────────
        Conventions :
          left_partner_type / right_partner_type :
            'p' = personne (is_company=False)
            'c' = compagnie (is_company=True)
            (vide) = tous types
          is_symmetric = True  → le label est identique dans les deux sens
    -->
    <!-- ── Romantique / Affectif ─────────────────────────────────────── -->
    <record id="rel_type_partner" model="res.partner.relation.type">
        <field name="name">Partenaire de</field>
        <field name="name_inverse">Partenaire de</field>
        <field name="is_symmetric" eval="True" />
        <field name="left_partner_type">p</field>
        <field name="right_partner_type">p</field>
        <field name="circle_type_id" ref="circle_type_partenaires" />
    </record>

    <record id="rel_type_spouse" model="res.partner.relation.type">
        <field name="name">Conjoint(e) de</field>
        <field name="name_inverse">Conjoint(e) de</field>
        <field name="is_symmetric" eval="True" />
        <field name="left_partner_type">p</field>
        <field name="right_partner_type">p</field>
        <field name="circle_type_id" ref="circle_type_partenaires" />
    </record>

    <record id="rel_type_poly" model="res.partner.relation.type">
        <field name="name">En relation poly avec</field>
        <field name="name_inverse">En relation poly avec</field>
        <field name="is_symmetric" eval="True" />
        <field name="left_partner_type">p</field>
        <field name="right_partner_type">p</field>
        <field name="circle_type_id" ref="circle_type_partenaires" />
    </record>
    <!-- ── Dynamique D/s ─────────────────────────────────────────────── -->
