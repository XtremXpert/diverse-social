<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!--
        Relation types between members — Club l'Orage
        ─────────────────────────────────────────────
        Conventions:
          left_partner_type / right_partner_type:
            'p' = individual (is_company=False)
            'c' = company (is_company=True)
            (empty) = any type
          is_symmetric = True  → the label is identical in both directions
    -->
    <!-- ── Romantic / Affective ──────────────────────────────────────── -->
    <record id="rel_type_partner" model="res.partner.relation.type">
        <field name="name">Partner of</field>
        <field name="name_inverse">Partner of</field>
        <field name="is_symmetric" eval="True" />
        <field name="left_partner_type">p</field>
        <field name="right_partner_type">p</field>
        <field name="circle_type_id" ref="circle_type_partenaires" />
    </record>

    <record id="rel_type_spouse" model="res.partner.relation.type">
        <field name="name">Spouse of</field>
        <field name="name_inverse">Spouse of</field>
        <field name="is_symmetric" eval="True" />
        <field name="left_partner_type">p</field>
        <field name="right_partner_type">p</field>
        <field name="circle_type_id" ref="circle_type_partenaires" />
    </record>

    <record id="rel_type_poly" model="res.partner.relation.type">
        <field name="name">In poly relationship with</field>
        <field name="name_inverse">In poly relationship with</field>
        <field name="is_symmetric" eval="True" />
        <field name="left_partner_type">p</field>
        <field name="right_partner_type">p</field>
