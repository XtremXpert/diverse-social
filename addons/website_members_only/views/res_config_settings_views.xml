<?xml version="1.0" encoding="utf-8"?>
<odoo>

<record id="res_config_settings_view_website_members_only" model="ir.ui.view">
    <field name="name">res.config.settings.view.website.members.only</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="website_sale.res_config_settings_view_form"/>
    <field name="arch" type="xml">
        <div id="ecommerce_access_setting" position="after">
            <div class="col-12 col-lg-6 o_setting_box" id="event_login_required_setting">
                <div class="o_setting_left_pane">
                    <field name="event_login_required"/>
                </div>
                <div class="o_setting_right_pane">
                    <label for="event_login_required" string="Événements réservés aux membres"/>
                    <div class="text-muted">
                        Les visiteurs non connectés sont redirigés vers la page de connexion
                        avant de pouvoir consulter les événements.
                    </div>
                </div>
            </div>
        </div>
    </field>
</record>

</odoo>
