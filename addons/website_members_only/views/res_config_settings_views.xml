<?xml version="1.0" encoding="utf-8"?>
<odoo>

<record id="res_config_settings_view_website_members_only" model="ir.ui.view">
    <field name="name">res.config.settings.view.website.members.only</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="website.res_config_settings_view_form"/>
    <field name="arch" type="xml">
        <setting id="website_login_documents" position="after">
            <setting id="event_login_required_setting" title="Événements réservés aux membres" help="Les visiteurs non connectés sont redirigés vers la page de connexion avant de pouvoir consulter les événements.">
                <field name="event_login_required"/>
                <label for="event_login_required" string="Événements réservés aux membres"/>
            </setting>
        </setting>
    </field>
</record>

</odoo>
