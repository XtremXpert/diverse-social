<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_social_messaging_thread_list" model="ir.ui.view">
            <field name="name">social_messaging.thread.list</field>
            <field name="model">social_messaging.thread</field>
            <field name="arch" type="xml">
                <list string="Threads" default_order="last_message_date desc">
                    <field name="participant_ids" widget="many2many_tags"/>
                    <field name="last_message_date"/>
                    <field name="last_message_preview"/>
                </list>
            </field>
        </record>

        <record id="view_social_messaging_thread_form" model="ir.ui.view">
            <field name="name">social_messaging.thread.form</field>
            <field name="model">social_messaging.thread</field>
            <field name="arch" type="xml">
                <form string="Thread">
                    <sheet>
                        <group>
                            <field name="participant_ids" widget="many2many_tags"/>
                            <field name="last_message_date" readonly="1"/>
                        </group>
                        <field name="message_ids">
                            <list>
                                <field name="author_id"/>
                                <field name="content"/>
                                <field name="create_date"/>
                                <field name="read_by_ids" widget="many2many_tags"/>
                            </list>
                        </field>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_social_messaging_threads" model="ir.actions.act_window">
            <field name="name">Messages</field>
            <field name="res_model">social_messaging.thread</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_social_messaging" name="Messages"
                  parent="social_base.menu_social_base_root"
                  sequence="50"
                  action="action_social_messaging_threads"/>

    </data>
</odoo>
