<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_social_gallery_list" model="ir.ui.view">
            <field name="name">social_gallery.gallery.list</field>
            <field name="model">social_gallery.gallery</field>
            <field name="arch" type="xml">
                <list string="Galleries">
                    <field name="name"/>
                    <field name="owner_id"/>
                    <field name="visibility"/>
                    <field name="is_shared"/>
                    <field name="approved_photo_count"/>
                    <field name="pending_photo_count"/>
                </list>
            </field>
        </record>

        <record id="view_social_gallery_form" model="ir.ui.view">
            <field name="name">social_gallery.gallery.form</field>
            <field name="model">social_gallery.gallery</field>
            <field name="arch" type="xml">
                <form string="Gallery">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="owner_id"/>
                                <field name="visibility"/>
                                <field name="is_shared"/>
                            </group>
                            <group>
                                <field name="photo_count" readonly="1"/>
                                <field name="approved_photo_count" readonly="1"/>
                                <field name="pending_photo_count" readonly="1"/>
                            </group>
                        </group>
                        <field name="description" nolabel="1" placeholder="Description..."/>
                        <notebook>
                            <page string="Photos">
                                <field name="photo_ids">
                                    <list>
                                        <field name="name"/>
                                        <field name="submitted_by_id"/>
                                        <field name="state"/>
                                        <field name="sequence" widget="handle"/>
                                        <button name="action_approve" string="Approve" type="object"
                                                invisible="state != 'pending'"
                                                groups="social_base.group_social_moderator"/>
                                        <button name="action_reject" string="Reject" type="object"
                                                invisible="state != 'pending'"
                                                groups="social_base.group_social_moderator"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_social_galleries" model="ir.actions.act_window">
            <field name="name">Galleries</field>
            <field name="res_model">social_gallery.gallery</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_social_galleries" name="Galleries"
                  parent="social_base.menu_social_base_root"
                  sequence="45"
                  action="action_social_galleries"/>

    </data>
</odoo>
