<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Cartes du portail /my (Odoo 20 : portal.entry remplace les t-call portal_docs_entry) -->
    <record id="portal_entry_my_membership" model="portal.entry">
        <field name="name">Adhésion</field>
        <field name="url">/my/membership</field>
        <field name="image" type="bytes" file="club_membership_website/static/src/img/membership.svg"/>
        <field name="placeholder_count">membership_count</field>
        <field name="is_config_card" eval="True"/>
        <field name="sequence" eval="30"/>
    </record>
</odoo>
