<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="membership_page" name="Memberships — Vitrine">
        <t t-call="website.layout">
            <div class="oe_structure" id="oe_structure_membership_top"/>

            <section class="s_text_block pt-5 pb-3">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-lg-8 text-center">
                            <h1>Devenir membre</h1>
                            <p class="lead text-muted">
                                Rejoignez notre communauté et accédez au réseau social privé du club.
                            </p>
                        </div>
                    </div>
                </div>
            </section>

            <section class="s_features py-5 bg-light">
                <div class="container">
                    <div class="row g-4 justify-content-center">
                        <t t-foreach="types" t-as="mtype">
                            <div class="col-md-6 col-lg-4">
                                <div class="card h-100 shadow-sm">
                                    <div class="card-body d-flex flex-column">
                                        <h3 class="card-title h5">
                                            <t t-out="mtype.name"/>
                                        </h3>
                                        <p class="text-muted small" t-if="mtype.description">
                                            <t t-out="mtype.description"/>
                                        </p>
                                        <div class="mt-auto">
                                            <div class="mb-2">
                                                <span class="fs-4 fw-bold" t-if="mtype.fee">
                                                    <t t-out="'{:,.2f}'.format(mtype.fee)"/>
                                                    <t t-out="mtype.currency_id.symbol"/>
                                                </span>
                                                <span class="text-muted small ms-1" t-if="mtype.duration_months">
                                                    / <t t-out="mtype.duration_months"/> mois
                                                </span>
                                                <span class="text-muted small ms-1" t-if="not mtype.duration_months">
                                                    à vie
                                                </span>
                                            </div>
                                            <t t-if="mtype.id in type_products">
                                                <form t-attf-action="/membership/join/#{mtype.id}" method="post">
                                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                    <button type="submit" class="btn btn-primary w-100">
                                                        S'inscrire
                                                    </button>
                                                </form>
                                            </t>
                                            <t t-else="">
                                                <a href="/contactus" class="btn btn-outline-secondary w-100">
                                                    Nous contacter
                                                </a>
                                            </t>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>

                    <div class="row mt-5" t-if="not types">
                        <div class="col text-center text-muted">
                            <p>Aucun type d'adhésion disponible pour le moment.</p>
                        </div>
                    </div>
                </div>
            </section>

            <div class="oe_structure" id="oe_structure_membership_bottom"/>
        </t>
    </template>

</odoo>
