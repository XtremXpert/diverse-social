<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Request ──────────────────────────────────────────────────────────── -->

    <record id="view_consent_request_form" model="ir.ui.view">
        <field name="name">social_consent.request.form</field>
        <field name="model">social_consent.request</field>
        <field name="arch" type="xml">
            <form string="Consent Request">
                <header>
                    <button name="action_submit" type="object" string="Submit"
                            invisible="state != 'draft'"
                            class="btn-primary"/>
                    <button name="action_mark_under_review" type="object" string="Mark Under Review"
                            invisible="state != 'submitted'"/>
                    <button name="action_approve" type="object" string="Approve"
                            invisible="state not in ('submitted','under_review')"
                            class="btn-success"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state not in ('submitted','under_review')"
                            class="btn-danger"/>
                    <button name="action_withdraw" type="object" string="Withdraw"
                            invisible="state not in ('draft','submitted','under_review')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,under_review,approved,rejected"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="gate_id"/>
                            <field name="profile_id"/>
                            <field name="requester_id"/>
                        </group>
                        <group>
                            <field name="submitted_at"/>
                            <field name="reviewed_at"/>
                            <field name="can_review"/>
                        </group>
                    </group>
                    <group string="Owner's Note" invisible="not reviewer_note">
                        <field name="reviewer_note" nolabel="1"/>
                    </group>
                    <separator string="Answers"/>
                    <field name="answer_ids">
                        <list editable="bottom">
                            <field name="item_text" readonly="1"/>
                            <field name="item_type" readonly="1"/>
                            <field name="checked" optional="show"
                                   column_invisible="item_type != 'check'"/>
                            <field name="text" optional="show"
                                   column_invisible="item_type != 'question'"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_consent_request_list" model="ir.ui.view">
        <field name="name">social_consent.request.list</field>
        <field name="model">social_consent.request</field>
        <field name="arch" type="xml">
            <list string="Consent Requests" decoration-warning="state == 'submitted'"
                  decoration-success="state == 'approved'" decoration-muted="state in ('rejected','withdrawn')">
                <field name="profile_id"/>
                <field name="requester_id"/>
                <field name="state"/>
                <field name="submitted_at"/>
                <field name="reviewed_at"/>
                <field name="can_review"/>
            </list>
        </field>
    </record>

    <record id="action_my_consent_requests_inbox" model="ir.actions.act_window">
        <field name="name">Consent Requests (Inbox)</field>
        <field name="res_model">social_consent.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('gate_id.profile_id.user_id', '=', uid), ('state', 'in', ['submitted','under_review'])]</field>
        <field name="context">{'search_default_submitted': 1}</field>
    </record>

    <record id="action_my_sent_requests" model="ir.actions.act_window">
        <field name="name">My Consent Requests (Sent)</field>
        <field name="res_model">social_consent.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('requester_id', '=', uid)]</field>
    </record>

    <record id="action_consent_requests_admin" model="ir.actions.act_window">
        <field name="name">All Consent Requests</field>
        <field name="res_model">social_consent.request</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
