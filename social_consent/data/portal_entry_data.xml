<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Cartes du portail /my (Odoo 20 : portal.entry remplace les t-call portal_docs_entry) -->
    <record id="portal_entry_my_consent" model="portal.entry">
        <field name="name">Consentement</field>
        <field name="url">/my/consent</field>
        <field name="image" type="bytes" file="social_consent/static/src/img/consent.svg"/>
        <field name="placeholder_count">consent_count</field>
        <field name="is_config_card" eval="True"/>
        <field name="sequence" eval="40"/>
    </record>
</odoo>
