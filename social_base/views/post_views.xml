<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_social_base_post_list" model="ir.ui.view">
            <field name="name">social_base.post.list</field>
            <field name="model">social_base.post</field>
            <field name="arch" type="xml">
                <list string="Posts" default_order="create_date desc">
                    <field name="author_id"/>
                    <field name="create_date"/>
                    <field name="state"/>
                    <field name="visibility"/>
                    <field name="like_count"/>
                    <field name="comment_count"/>
                    <field name="view_count"/>
                    <field name="media_type"/>
                </list>
            </field>
        </record>

        <record id="view_social_base_post_form" model="ir.ui.view">
            <field name="name">social_base.post.form</field>
            <field name="model">social_base.post</field>
            <field name="arch" type="xml">
                <form string="Post">
                    <header>
                        <button name="action_publish" string="Publish" type="object" class="btn-primary"
                                invisible="state not in ['draft', 'moderation']"/>
                        <button name="action_submit_moderation" string="Submit for Moderation" type="object"
                                invisible="state != 'draft'"/>
                        <button name="action_archive" string="Archive" type="object"
                                invisible="state != 'published'"/>
                        <button name="action_approve" string="Approve" type="object"
                                invisible="state != 'moderation'"
                                groups="social_base.group_social_moderator"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="author_id" readonly="1"/>
                                <field name="create_date" readonly="1"/>
                                <field name="visibility"/>
                                <field name="media_type" readonly="1"/>
                            </group>
                            <group>
                                <field name="like_count" readonly="1"/>
                                <field name="comment_count" readonly="1"/>
                                <field name="view_count" readonly="1"/>
                                <field name="share_count" readonly="1"/>
                                <field name="is_pinned"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Content">
                                <field name="content" widget="html"/>
                            </page>
                            <page string="Comments">
                                <field name="comment_ids">
                                    <list>
                                        <field name="author_id"/>
                                        <field name="content"/>
                                        <field name="create_date"/>
                                        <field name="like_count"/>
                                        <field name="state"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Reactions">
                                <field name="reaction_ids">
                                    <list>
                                        <field name="user_id"/>
                                        <field name="type"/>
                                        <field name="create_date"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Moderation" groups="social_base.group_social_moderator">
                                <group>
                                    <field name="moderated_by"/>
                                    <field name="moderation_date"/>
                                    <field name="moderation_reason"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_social_base_post_search" model="ir.ui.view">
            <field name="name">social_base.post.search</field>
            <field name="model">social_base.post</field>
            <field name="arch" type="xml">
                <search string="Search Posts">
                    <field name="author_id"/>
                    <field name="content"/>
                    <field name="state"/>
                    <field name="visibility"/>
                </search>
            </field>
        </record>

        <record id="action_social_base_posts" model="ir.actions.act_window">
            <field name="name">Posts</field>
            <field name="res_model">social_base.post</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'default_state': 'published'}</field>
        </record>

        <menuitem id="menu_social_base_root" name="Social" sequence="50"/>
        <menuitem id="menu_social_base_posts" name="Posts" parent="menu_social_base_root" sequence="10"
                  action="action_social_base_posts"/>

        <record id="view_social_base_comment_list" model="ir.ui.view">
            <field name="name">social_base.comment.list</field>
            <field name="model">social_base.comment</field>
            <field name="arch" type="xml">
                <list string="Comments" default_order="create_date desc">
                    <field name="author_id"/>
                    <field name="content"/>
                    <field name="create_date"/>
                    <field name="state"/>
                    <field name="like_count"/>
                    <field name="post_id"/>
                </list>
            </field>
        </record>

        <record id="action_social_base_comments" model="ir.actions.act_window">
            <field name="name">Comments</field>
            <field name="res_model">social_base.comment</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_social_base_comments" name="Comments" parent="menu_social_base_root" sequence="20"
                  action="action_social_base_comments"/>

    </data>
</odoo>
