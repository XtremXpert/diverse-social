<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_call_session" model="ir.sequence">
        <field name="name">Social Calling Session</field>
        <field name="code">social_calling.session</field>
        <field name="prefix">CALL-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="cron_mark_missed_calls" model="ir.cron">
        <field name="name">Social Calling: Mark missed calls</field>
        <field name="model_id" ref="model_social_calling_session"/>
        <field name="state">code</field>
        <field name="code">model.cron_mark_missed_calls()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <record id="cron_purge_old_calls" model="ir.cron">
        <field name="name">Social Calling: Purge old calls (Loi 25)</field>
        <field name="model_id" ref="model_social_calling_session"/>
        <field name="state">code</field>
        <field name="code">model.cron_purge_old_calls()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <!-- Durée de rétention (jours) ; éditable, créé une seule fois. 0 = illimité. -->
    <data noupdate="1">
        <record id="param_retention_days" model="ir.config_parameter">
            <field name="key">social_calling.retention_days</field>
            <field name="value">90</field>
        </record>
    </data>
</odoo>
