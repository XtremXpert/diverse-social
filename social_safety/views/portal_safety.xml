<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══ Quick-exit button (all portal pages) ═════════════════════════════ -->
    <record id="assets_quick_exit" model="ir.asset">
        <field name="name">Social Safety Quick Exit JS</field>
        <field name="bundle">web.assets_frontend</field>
        <field name="path">/social_safety/static/src/js/quick_exit.js</field>
    </record>

    <template id="portal_quick_exit_button" inherit_id="web.frontend_layout"
              name="Quick exit">
        <xpath expr="//header" position="inside">
            <t t-set="_sp" t-value="request.env['club_social_profile.profile'].sudo().search([('user_id','=',request.env.user.id)],limit=1)"/>
            <t t-if="request.env.user and not request.env.user._is_public() and _sp.safety_kit_enabled">
                <t t-set="_get_param" t-value="request.env['ir.config_parameter'].sudo().get_param"/>
                <t t-set="_exit_url" t-value="_get_param('social_safety.quick_exit_url', 'https://www.meteomedia.com/')"/>
                <t t-set="_camouflage_title" t-value="_get_param('social_safety.camouflage_title', 'MétéoMédia — Prévisions Québec')"/>
                <t t-set="_camouflage_favicon" t-value="_get_param('social_safety.camouflage_favicon', 'data:image/svg+xml;utf8,&lt;svg xmlns=&quot;http://www.w3.org/2000/svg&quot; viewBox=&quot;0 0 16 16&quot;&gt;&lt;text y=&quot;14&quot; font-size=&quot;14&quot;&gt;⛅&lt;/text&gt;&lt;/svg&gt;')"/>
                <style>
                    #social_quick_exit {
                        position: fixed;
                        bottom: 16px;
                        left: 16px;
                        z-index: 1050;
                        background: #555;
                        border: none;
                        border-radius: 6px;
                        width: 42px;
                        height: 42px;
                        cursor: pointer;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        font-size: 18px;
                        color: white;
                        box-shadow: 0 2px 8px rgba(0,0,0,.3);
                        opacity: 0.55;
                        transition: opacity .15s, background .15s;
                        text-decoration: none;
                    }
                    #social_quick_exit:hover {
                        opacity: 1;
                        background: #e94560;
                    }
                    #social_quick_exit title { display: none; }
                </style>
                <button id="social_quick_exit"
                        t-att-data-exit-url="_exit_url"
                        t-att-data-camouflage-title="_camouflage_title"
                        t-att-data-camouflage-favicon="_camouflage_favicon"
                        title="Quick exit (also: press Esc twice)">
                    ⏻
                </button>
            </t>
        </xpath>
    </template>

    <!-- ══ /safety page ══════════════════════════════════════════════════════ -->
    <template id="portal_safety_page" name="Safety and privacy">
        <t t-call="portal.portal_layout">
            <t t-set="head_title">Safety</t>
            <div class="o_portal_wrap">
                <div class="container py-4" style="max-width:720px;">

                    <h2 class="mb-4" style="color:#1a1a2e;">🔐 Safety and privacy</h2>

                    <!-- ── Safety kit opt-in ── -->
                    <div class="card mb-4">
                        <div class="card-header fw-bold" style="background:#1a1a2e; color:white;">
                            🧰 Safety kit
                        </div>
                        <div class="card-body">
                            <p class="text-muted mb-3">The safety kit adds a discreet quick-exit button (bottom-left, also triggered by pressing Esc twice), camouflages the tab title/favicon on sensitive pages, and enables the stealth-mode toggle on your profile. Off by default — enable it only if you want it.</p>
                            <t t-if="profile and profile.safety_kit_enabled">
                                <div class="d-flex align-items-center gap-2 mb-3">
                                    <span class="badge bg-success">Enabled</span>
                                </div>
                                <form action="/safety/kit/toggle" method="post">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <button type="submit" class="btn btn-outline-secondary">
                                        Disable safety kit
                                    </button>
                                </form>
                            </t>
                            <t t-else="">
                                <form action="/safety/kit/toggle" method="post">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <input type="hidden" name="enabled" value="1"/>
                                    <button type="submit" class="btn" style="background:#1a1a2e; color:white;">
                                        🧰 Enable safety kit
                                    </button>
                                </form>
                            </t>
                        </div>
                    </div>

                    <!-- ── Stealth mode ── -->
                    <div class="card mb-4">
                        <div class="card-header fw-bold" style="background:#1a1a2e; color:white;">
                            🕵️ Stealth mode (panic mode)
                        </div>
                        <div class="card-body">
                            <t t-if="profile and profile.panic_mode">
                                <div class="alert alert-warning d-flex align-items-center gap-2 mb-3">
                                    <span style="font-size:1.4rem;">⚠️</span>
                                    <div>
                                        <strong>Stealth mode active</strong> depuis
                                        <t t-out="profile.panic_activated_at.strftime('%d/%m/%Y at %H:%M') if profile.panic_activated_at else '?'"/>.
                                        Your profile is hidden from discovery and limited to your connections.
                                    </div>
                                </div>
                                <form action="/safety/panic/lift" method="post">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <button type="submit" class="btn btn-outline-secondary">
                                        Disable stealth mode
                                    </button>
                                </form>
                            </t>
                            <t t-else="">
                                <p class="text-muted mb-3">
                                    In stealth mode, your profile disappears from discovery and is only
                                    visible to your connections. You can re-enable it any time.
                                </p>
                                <form action="/safety/panic/activate" method="post">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <button type="submit" class="btn" style="background:#e94560; color:white;">
                                        🕵️ Enable stealth mode
                                    </button>
                                </form>
                            </t>
                        </div>
                    </div>

                    <!-- ── Quick exit ── -->
                    <div class="card mb-4">
                        <div class="card-header fw-bold" style="background:#1a1a2e; color:white;">
                            ⏻ Quick exit
                        </div>
                        <div class="card-body">
                            <p class="text-muted mb-2">The <strong>⏻</strong> button in the bottom-left corner of every page sends you instantly to a neutral site without leaving traces in history. You can also press <strong>Esc twice</strong>.</p>
                            <p class="mb-0 text-muted" style="font-size:0.85rem;">
                                Destination site:
                                <strong t-out="exit_url"/>
                            </p>
                        </div>
                    </div>

                    <!-- ── Blocked users ── -->
                    <div class="card mb-4">
                        <div class="card-header fw-bold" style="background:#1a1a2e; color:white;">
                            🚫 Blocked users
                            <t t-if="blocks">
                                <span class="badge ms-2" style="background:#e94560;">
                                    <t t-out="len(blocks)"/>
                                </span>
                            </t>
                        </div>
                        <t t-if="blocks">
                            <ul class="list-group list-group-flush">
                                <t t-foreach="blocks" t-as="block">
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <span>
                                            <strong t-out="block.blocked_id.name"/>
                                            <span class="text-muted ms-2" style="font-size:0.8rem;">
                                                since <t t-out="block.create_date.strftime('%d/%m/%Y') if block.create_date else '?'"/>
                                            </span>
                                        </span>
                                        <form t-attf-action="/safety/block/#{block.id}/remove" method="post" class="m-0">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">
                                                Unblock
                                            </button>
                                        </form>
                                    </li>
                                </t>
                            </ul>
                        </t>
                        <t t-else="">
                            <div class="card-body text-muted" style="font-size:0.9rem;">
                                No blocked users.
                            </div>
                        </t>
                    </div>

                    <!-- ── Muted users ── -->
                    <div class="card mb-4">
                        <div class="card-header fw-bold" style="background:#1a1a2e; color:white;">
                            🔇 Muted users
                            <t t-if="mutes">
                                <span class="badge ms-2" style="background:#666;">
                                    <t t-out="len(mutes)"/>
                                </span>
                            </t>
                        </div>
                        <t t-if="mutes">
                            <ul class="list-group list-group-flush">
                                <t t-foreach="mutes" t-as="mute">
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <span>
                                            <strong t-out="mute.muted_id.name"/>
                                            <t t-if="mute.until">
                                                <span class="text-muted ms-2" style="font-size:0.8rem;">
                                                    until <t t-out="mute.until.strftime('%d/%m/%Y') if mute.until else ''"/>
                                                </span>
                                            </t>
                                            <t t-else="">
                                                <span class="text-muted ms-2" style="font-size:0.8rem;">
                                                    indefinitely
                                                </span>
                                            </t>
                                        </span>
                                        <form t-attf-action="/safety/mute/#{mute.id}/remove" method="post" class="m-0">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">
                                                Unmute
                                            </button>
                                        </form>
                                    </li>
                                </t>
                            </ul>
                        </t>
                        <t t-else="">
                            <div class="card-body text-muted" style="font-size:0.9rem;">
                                No muted users.
                            </div>
                        </t>
                    </div>

                </div>
            </div>
        </t>
    </template>

    <!-- ══ Panic toggle on profile page (owner) ═════════════════════════════ -->
    <template id="portal_profile_panic_inject"
              inherit_id="club_social_profile.portal_profile_public"
              name="Profile — Stealth mode button">
        <xpath expr="//a[@href='/my/profile/edit']" position="after">
            <t t-if="is_own and profile.safety_kit_enabled and profile.panic_mode">
                <form action="/safety/panic/lift" method="post" class="d-block d-sm-inline-block mt-2 mt-sm-0 ms-sm-2">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <button type="submit" class="btn btn-warning btn-sm">
                        🕵️ Stealth mode on — Disable
                    </button>
                </form>
            </t>
            <t t-elif="is_own and profile.safety_kit_enabled">
                <form action="/safety/panic/activate" method="post" class="d-block d-sm-inline-block mt-2 mt-sm-0 ms-sm-2">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <button type="submit" class="btn btn-outline-secondary btn-sm">
                        🕵️ Stealth mode
                    </button>
                </form>
            </t>
        </xpath>
    </template>

    <!-- ══ Portal navigation entry ═══════════════════════════════════════════ -->
    <template id="portal_my_home_safety" inherit_id="portal.portal_my_home"
              name="Portal — Safety">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Sécurité</t>
                <t t-set="url">/safety</t>
                <t t-set="icon" t-value="'/social_safety/static/src/img/safety.svg'"/>
                <t t-set="config_card" t-value="True"/>
            </t>
        </xpath>
    </template>

</odoo>
