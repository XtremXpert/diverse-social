<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mute_list" model="ir.ui.view">
        <field name="name">social_safety.mute.list</field>
        <field name="model">social_safety.mute</field>
        <field name="arch" type="xml">
            <list string="Muted Users"
                  decoration-muted="not is_active">
                <field name="muted_id"/>
                <field name="until"/>
                <field name="is_active"/>
                <field name="create_date" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="view_mute_form" model="ir.ui.view">
        <field name="name">social_safety.mute.form</field>
        <field name="model">social_safety.mute</field>
        <field name="arch" type="xml">
            <form string="Mute">
                <sheet>
                    <group>
                        <field name="muted_id"/>
                        <field name="until" placeholder="Leave empty for permanent"/>
                        <field name="is_active" readonly="1"/>
                        <field name="create_date" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_my_mutes" model="ir.actions.act_window">
        <field name="name">Muted Users</field>
        <field name="res_model">social_safety.mute</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('muter_id', '=', uid)]</field>
        <field name="context">{'default_muter_id': uid}</field>
    </record>

</odoo>
