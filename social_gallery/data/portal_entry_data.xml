<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Cartes du portail /my (Odoo 20 : portal.entry remplace les t-call portal_docs_entry) -->
    <record id="portal_entry_my_gallery" model="portal.entry">
        <field name="name">Galerie</field>
        <field name="url">/my/gallery</field>
        <field name="image" type="bytes" file="social_gallery/static/src/img/gallery.svg"/>
        <field name="placeholder_count">gallery_pending_count</field>
        <field name="is_config_card" eval="True"/>
        <field name="sequence" eval="40"/>
    </record>
</odoo>
