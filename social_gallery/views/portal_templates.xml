<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══ Assets ════════════════════════════════════════════════════════════ -->
    <record id="assets_portal_gallery" model="ir.asset">
        <field name="name">Social Gallery Portal JS</field>
        <field name="bundle">web.assets_frontend</field>
        <field name="path">/social_gallery/static/src/js/portal_gallery_lightbox.js</field>
    </record>

    <!-- ── Entrée portail home ──────────────────────────────────────────────── -->

    <template id="portal_my_home_gallery" name="Portal My Home : Gallery"
              inherit_id="portal.portal_my_home" customize_show="False" priority="40">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Galerie</t>
                <t t-set="url">/my/gallery</t>
                <t t-set="icon" t-value="'/social_gallery/static/src/img/gallery.svg'"/>
                <t t-set="placeholder_count">gallery_pending_count</t>
                <t t-set="config_card" t-value="True"/>
            </t>
        </xpath>
    </template>

    <!-- ── Liste des galeries ──────────────────────────────────────────────── -->

    <template id="portal_gallery_list" name="Galeries">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="False"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Galeries</t>
            </t>
            <div class="container mt-4">
                <t t-if="not galleries">
                    <div class="alert alert-info">Aucune galerie disponible.</div>
                </t>
                <div class="row g-3">
                    <t t-foreach="galleries" t-as="gallery">
                        <div class="col-12 col-md-6 col-lg-4">
                            <a t-attf-href="/gallery/#{gallery.id}" class="text-decoration-none">
                                <div class="card h-100 shadow-sm">
                                    <t t-if="gallery.cover_photo_id">
                                        <img t-attf-src="/web/image/social_gallery.photo/#{gallery.cover_photo_id.id}/image_512"
                                             class="card-img-top" style="height:180px;object-fit:cover;"
                                             t-att-alt="gallery.name"/>
                                    </t>
                                    <div class="card-body">
                                        <h5 class="card-title mb-1" t-esc="gallery.name"/>
                                        <p class="text-muted small mb-0">
                                            <t t-esc="gallery.approved_photo_count"/> photo(s)
                                            <t t-if="gallery.is_shared"> · Galerie participative</t>
                                        </p>
                                        <p t-if="gallery.description" class="card-text mt-2 small"
                                           t-esc="gallery.description"/>
                                    </div>
                                </div>
                            </a>
                        </div>
                    </t>
                </div>
            </div>
        </t>
    </template>

    <!-- ── Détail d'une galerie ────────────────────────────────────────────── -->

    <template id="portal_gallery_detail" name="Galerie – détail">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="False"/>
            <nav aria-label="breadcrumb" class="container mt-3">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/gallery">Galeries</a></li>
                    <li class="breadcrumb-item active" t-esc="gallery.name"/>
                </ol>
            </nav>

            <div class="container mt-2">

                <!-- En-tête galerie -->
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
                    <div>
                        <h3 class="mb-1" t-esc="gallery.name"/>
                        <p t-if="gallery.description" class="text-muted mb-1" t-esc="gallery.description"/>
                        <!-- Propriétaire -->
                        <t t-if="gallery.owner_id">
                            <small class="text-muted">
                                Par
                                <t t-if="owner_profile">
                                    <a t-attf-href="/profile/#{gallery.owner_id.id}"
                                       t-esc="owner_profile.stealth_name or gallery.owner_id.name"/>
                                </t>
                                <t t-else="">
                                    <span t-esc="gallery.owner_id.name"/>
                                </t>
                            </small>
                        </t>
                    </div>
                    <span class="badge bg-secondary" style="font-size:.85rem;">
                        <t t-esc="gallery.approved_photo_count"/> photo(s)
                        <t t-if="gallery.is_shared"> · Participative</t>
                    </span>
                </div>

                <!-- Alertes -->
                <t t-set="is_owner" t-value="gallery.owner_id.id == request.env.user.id"/>
                <t t-if="request.params.get('success')">
                    <div class="alert alert-success">
                        <t t-if="is_owner">Votre média a été ajouté à la galerie.</t>
                        <t t-else="">Votre média a été soumis et est en attente de modération.</t>
                    </div>
                </t>
                <t t-if="request.params.get('error') == 'media_required'">
                    <div class="alert alert-danger">Veuillez sélectionner un fichier (image ou vidéo).</div>
                </t>
                <t t-if="request.params.get('error') == 'too_large'">
                    <div class="alert alert-danger">Fichier trop volumineux (maximum 25 Mo).</div>
                </t>
                <t t-if="request.params.get('error') == 'bad_type'">
                    <div class="alert alert-danger">Type de fichier non supporté (images et vidéos uniquement).</div>
                </t>
                <t t-if="request.params.get('deleted')">
                    <div class="alert alert-info">Média supprimé.</div>
                </t>

                <!-- Formulaire d'ajout : propriétaire (sur sa galerie) OU galerie participative -->
                <t t-if="gallery.is_shared or is_owner">
                    <div class="card mb-4">
                        <div class="card-header fw-bold" style="background:#1a1a2e;color:white;">
                            <t t-if="is_owner">📷 Ajouter une photo ou une vidéo</t>
                            <t t-else="">📷 Soumettre une photo ou une vidéo</t>
                        </div>
                        <div class="card-body">
                            <form t-attf-action="/gallery/#{gallery.id}/submit" method="post"
                                  enctype="multipart/form-data">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <div class="row g-3">
                                    <div class="col-md-7">
                                        <label class="form-label">Image ou vidéo <small class="text-muted">(max 25 Mo)</small></label>
                                        <input type="file" name="media" class="form-control" accept="image/*,video/*" required="required"/>
                                    </div>
                                    <div class="col-md-5">
                                        <label class="form-label">Titre (facultatif)</label>
                                        <input type="text" name="name" class="form-control" maxlength="128"/>
                                    </div>
                                </div>
                                <button type="submit" class="btn btn-sm mt-3"
                                        style="background:#e94560;color:white;">
                                    <t t-if="is_owner">Ajouter</t>
                                    <t t-else="">Soumettre</t>
                                </button>
                            </form>
                        </div>
                    </div>
                </t>

                <!-- Grille photos avec lightbox -->
                <t t-if="not photos">
                    <div class="text-center py-5">
                        <div style="font-size:2.5rem;">🖼️</div>
                        <p class="text-muted mt-2">Aucune photo dans cette galerie.</p>
                    </div>
                </t>
                <div id="sn_gallery_grid" class="row g-2">
                    <t t-foreach="photos" t-as="photo">
                        <div class="col-6 col-md-4 col-lg-3">
                            <!-- Vidéo : lecteur inline (pas de lightbox) -->
                            <t t-if="photo.media_type == 'video'">
                                <div class="position-relative overflow-hidden rounded" style="height:160px;background:#000;">
                                    <video controls="controls" preload="metadata"
                                           class="w-100 h-100" style="object-fit:contain;background:#000;"
                                           t-attf-src="/web/content/social_gallery.photo/#{photo.id}/video_file?filename_field=video_filename">
                                    </video>
                                    <t t-if="photo.name">
                                        <div class="position-absolute bottom-0 start-0 end-0 px-2 py-1"
                                             style="background:linear-gradient(transparent,rgba(0,0,0,.6));font-size:.75rem;color:white;pointer-events:none;">
                                            <t t-esc="photo.name"/>
                                        </div>
                                    </t>
                                </div>
                            </t>
                            <!-- Image : vignette + lightbox -->
                            <t t-else="">
                                <a href="#"
                                   t-att-data-lightbox="photo.id"
                                   t-attf-data-src="/web/image/social_gallery.photo/#{photo.id}/image_1920"
                                   t-attf-data-thumb="/web/image/social_gallery.photo/#{photo.id}/image_512"
                                   t-att-data-caption="photo.name or ''"
                                   class="d-block position-relative overflow-hidden rounded"
                                   style="height:160px;">
                                    <img t-attf-src="/web/image/social_gallery.photo/#{photo.id}/image_512"
                                         class="w-100 h-100" style="object-fit:cover; transition:transform .2s;"
                                         t-att-alt="photo.name or gallery.name"/>
                                    <t t-if="photo.name">
                                        <div class="position-absolute bottom-0 start-0 end-0 px-2 py-1"
                                             style="background:linear-gradient(transparent,rgba(0,0,0,.6));font-size:.75rem;color:white;">
                                            <t t-esc="photo.name"/>
                                        </div>
                                    </t>
                                </a>
                            </t>
                        </div>
                    </t>
                </div>

                <!-- Pagination -->
                <t t-if="pager and pager['page_count'] &gt; 1">
                    <div class="mt-4">
                        <t t-call="portal.pager">
                            <t t-set="pager" t-value="pager"/>
                        </t>
                    </div>
                </t>

            </div>
        </t>
    </template>

    <!-- ── Mes photos soumises ─────────────────────────────────────────────── -->

    <template id="portal_my_gallery" name="Mes photos">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="False"/>

            <div class="container mt-3">

                <!-- Alertes -->
                <t t-if="request.params.get('created')">
                    <div class="alert alert-success">Galerie créée avec succès.</div>
                </t>
                <t t-if="request.params.get('deleted')">
                    <div class="alert alert-info">Photo supprimée.</div>
                </t>
                <t t-if="request.params.get('error') == 'name_required'">
                    <div class="alert alert-danger">Le nom de la galerie est requis.</div>
                </t>

                <!-- Mes galeries -->
                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                    <h4 class="mb-0" style="color:#1a1a2e;">Mes galeries</h4>
                    <button class="btn btn-sm" style="background:#e94560;color:white;"
                            data-bs-toggle="collapse" data-bs-target="#sn_create_gallery_form">
                        + Créer une galerie
                    </button>
                </div>

                <!-- Formulaire création galerie (collapse) -->
                <div class="collapse mb-4" id="sn_create_gallery_form">
                    <div class="card card-body">
                        <form action="/my/gallery/create" method="post">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <div class="row g-3">
                                <div class="col-md-5">
                                    <label class="form-label fw-semibold">Nom <span class="text-danger">*</span></label>
                                    <input type="text" name="name" class="form-control" maxlength="128" required="required"/>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-semibold">Visibilité</label>
                                    <select name="visibility" class="form-select">
                                        <option value="members">Membres seulement</option>
                                        <option value="public">Publique</option>
                                        <option value="private">Privée (moi seul)</option>
                                    </select>
                                </div>
                                <div class="col-md-3 d-flex align-items-end">
                                    <button type="submit" class="btn btn-sm w-100"
                                            style="background:#1a1a2e;color:white;">
                                        Créer
                                    </button>
                                </div>
                            </div>
                            <div class="mt-2">
                                <label class="form-label fw-semibold">Description (facultatif)</label>
                                <textarea name="description" class="form-control" rows="2" maxlength="500"/>
                            </div>
                        </form>
                    </div>
                </div>

                <t t-if="my_galleries">
                    <div class="row g-3 mb-5">
                        <t t-foreach="my_galleries" t-as="gal">
                            <div class="col-6 col-md-4 col-lg-3">
                                <a t-attf-href="/gallery/#{gal.id}" class="text-decoration-none">
                                    <div class="card h-100 shadow-sm">
                                        <t t-if="gal.cover_photo_id">
                                            <img t-attf-src="/web/image/social_gallery.photo/#{gal.cover_photo_id.id}/image_512"
                                                 class="card-img-top" style="height:130px;object-fit:cover;"
                                                 t-att-alt="gal.name"/>
                                        </t>
                                        <div t-else="" class="card-img-top d-flex align-items-center justify-content-center"
                                             style="height:130px;background:#f8f9fa;font-size:2rem;">
                                            🖼️
                                        </div>
                                        <div class="card-body py-2 px-3">
                                            <div class="fw-semibold" style="font-size:.9rem;" t-esc="gal.name"/>
                                            <small class="text-muted">
                                                <t t-esc="gal.approved_photo_count"/> photo(s)
                                            </small>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        </t>
                    </div>
                </t>
                <t t-else="">
                    <p class="text-muted mb-5">Vous n'avez aucune galerie personnelle.</p>
                </t>

                <!-- Mes photos soumises -->
                <h4 class="mb-3" style="color:#1a1a2e;">Mes photos soumises</h4>

                <div class="btn-group mb-3">
                    <a t-attf-href="/my/gallery"
                       t-attf-class="btn btn-sm #{'btn-secondary' if state_filter == 'all' else 'btn-outline-secondary'}">
                        Tout
                    </a>
                    <a t-attf-href="/my/gallery?state=pending"
                       t-attf-class="btn btn-sm #{'btn-warning' if state_filter == 'pending' else 'btn-outline-warning'}">
                        En attente
                    </a>
                    <a t-attf-href="/my/gallery?state=approved"
                       t-attf-class="btn btn-sm #{'btn-success' if state_filter == 'approved' else 'btn-outline-success'}">
                        Approuvées
                    </a>
                    <a t-attf-href="/my/gallery?state=rejected"
                       t-attf-class="btn btn-sm #{'btn-danger' if state_filter == 'rejected' else 'btn-outline-danger'}">
                        Rejetées
                    </a>
                </div>

                <t t-if="not photos">
                    <p class="text-muted">Aucune photo soumise.</p>
                </t>
                <div class="row g-3">
                    <t t-foreach="photos" t-as="photo">
                        <div class="col-6 col-md-4 col-lg-3">
                            <div class="position-relative">
                                <t t-if="photo.media_type == 'video'">
                                    <video controls="controls" preload="metadata"
                                           class="rounded shadow-sm"
                                           style="height:160px;width:100%;object-fit:contain;background:#000;"
                                           t-attf-src="/web/content/social_gallery.photo/#{photo.id}/video_file?filename_field=video_filename">
                                    </video>
                                </t>
                                <t t-else="">
                                    <img t-attf-src="/web/image/social_gallery.photo/#{photo.id}/image_512"
                                         class="img-fluid rounded shadow-sm"
                                         style="height:160px;width:100%;object-fit:cover;"
                                         t-att-alt="photo.name or ''"/>
                                </t>
                                <span t-att-class="'badge position-absolute top-0 end-0 m-1 ' + {'pending':'bg-warning text-dark','approved':'bg-success','rejected':'bg-danger'}.get(photo.state,'bg-secondary')"
                                      t-esc="{'pending':'En attente','approved':'Approuvée','rejected':'Rejetée'}.get(photo.state, photo.state)"/>
                                <!-- Bouton supprimer (pending ou rejected seulement) -->
                                <t t-if="photo.state != 'approved'">
                                    <form t-attf-action="/my/gallery/photo/#{photo.id}/delete" method="post"
                                          class="position-absolute top-0 start-0 m-1">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <button type="submit" class="btn btn-sm btn-danger py-0 px-1"
                                                style="font-size:.7rem;"
                                                onclick="return confirm('Supprimer cette photo ?')">
                                            ✕
                                        </button>
                                    </form>
                                </t>
                            </div>
                            <p class="small mt-1 mb-0">
                                <a t-attf-href="/gallery/#{photo.gallery_id.id}" t-esc="photo.gallery_id.name"/>
                            </p>
                        </div>
                    </t>
                </div>
                <t t-if="pager">
                    <div class="mt-4">
                        <t t-call="portal.pager">
                            <t t-set="pager" t-value="pager"/>
                        </t>
                    </div>
                </t>
            </div>
        </t>
    </template>

</odoo>
